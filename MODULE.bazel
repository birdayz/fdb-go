module(
    name = "fdb-record-layer-go",
    version = "0.0.0",
)

# Go
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Shell (sh_binary for codegen wrappers, e.g. the ANTLR parser generator).
bazel_dep(name = "rules_shell", version = "0.8.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module_override(
    patch_strip = 1,
    patches = [
        "//patches:fdb-go-range-iterator-done.patch",
        "//patches:fdb-go-native-cdeps.patch",
        "//patches:fdb-go-string-array-alignment.patch",
    ],
    path = "github.com/apple/foundationdb/bindings/go",
)

# One testcontainers session (and reaper) per Bazel test action; see the patch.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:testcontainers-session-per-bazel-test.patch"],
    path = "github.com/testcontainers/testcontainers-go",
)
use_repo(
    go_deps,
    "build_buf_go_protoyaml",
    "cc_mvdan_gofumpt",
    "co_honnef_go_tools",
    "com_github_andybalholm_brotli",
    "com_github_antlr4_go_antlr_v4",
    "com_github_apple_foundationdb_bindings_go",
    "com_github_birdayz_protobuf_ecosystem",
    "com_github_charmbracelet_x_term",
    "com_github_chzyer_readline",
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_containerd_errdefs",
    "com_github_docker_docker",
    "com_github_docker_go_connections",
    "com_github_google_cel_go",
    "com_github_google_uuid",
    "com_github_moby_go_archive",
    "com_github_moby_sys_user",
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "com_github_planetscale_vtprotobuf",
    "com_github_rivo_uniseg",
    "com_github_spf13_cobra",
    "com_github_stretchr_testify",
    "com_github_testcontainers_testcontainers_go",
    "com_github_zeebo_xxh3",
    "in_gopkg_yaml_v3",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlptrace",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_trace",
    "io_opentelemetry_go_proto_otlp",
    "land_charm_fang_v2",
    "land_charm_lipgloss_v2",
    "org_golang_google_protobuf",
    "org_golang_x_sys",
    "org_golang_x_text",
    "org_golang_x_tools",
    "org_uber_go_mock",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//:nogo")

# C++ (wire format generation + FDB build)
bazel_dep(name = "rules_cc", version = "0.2.26")

# FDB C++ source — fetched automatically from GitHub, pinned to tag.
# Bazel downloads, caches, and injects MODULE.bazel + BUILD.bazel via patch_cmds.
# FDB version — MUST match .bazelrc FDB_VERSION.
bazel_dep(name = "foundationdb", version = "7.3.77")
archive_override(
    module_name = "foundationdb",
    patch_cmds = [
        """cat > MODULE.bazel <<'MODEOF'
module(name = "foundationdb", version = "7.3.77")
bazel_dep(name = "rules_cc", version = "0.1.1")
MODEOF""",
        """cat > BUILD.bazel <<'BUILDEOF'
load("@rules_cc//cc:cc_library.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])

# All source files (for cmake genrule build).
filegroup(name = "all_srcs", srcs = glob(["**"]))

# Header-only subset (for lightweight test vector generator + stub extractor).
cc_library(
    name = "flow_headers",
    hdrs = glob([
        "flow/include/flow/flat_buffers.h",
        "flow/include/flow/FileIdentifier.h",
        "flow/include/flow/ObjectSerializerTraits.h",
    ]),
    includes = ["flow/include"],
)
exports_files([
    "flow/flat_buffers.cpp",
    "bindings/c/foundationdb/fdb_c_types.h",
])

# Binding tester Python files (for conformance testing).
filegroup(
    name = "bindingtester",
    srcs = glob(["bindings/bindingtester/**/*.py"]),
)

# Python FDB binding (needed by bindingtester).
filegroup(
    name = "python_fdb",
    srcs = glob(["bindings/python/**/*.py", "bindings/python/**/*.cmake"]),
)
BUILDEOF""",
    ],
    strip_prefix = "foundationdb-7.3.77",
    urls = ["https://github.com/apple/foundationdb/archive/refs/tags/7.3.77.tar.gz"],
)

# Proto (codegen stays with buf generate)
bazel_dep(name = "protobuf", version = "36.2")

# Java (conformance server)
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_android", version = "0.8.0")  # Override transitive dep for Bazel 9 compat

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.foundationdb:fdb-record-layer-core:4.14.2.0",
        "org.foundationdb:fdb-record-layer-icu:4.14.2.0",
        # fdb-relational-* artifacts power the Java side of the
        # plan-equivalence harness (RFC-022 §4.-1 Phase 2). Lowest
        # published version on Maven Central is 4.10.18.0; we run
        # 4.14.2.0 to match fdb-record-layer-core.
        "org.foundationdb:fdb-relational-api:4.14.2.0",
        "org.foundationdb:fdb-relational-core:4.14.2.0",
        "com.google.code.gson:gson:2.10.1",
    ],
    known_contributing_modules = [
        "bazel_worker_java",
        "protobuf",
    ],
    # Pinned resolution of every artifact above and its transitive closure.
    # Repin after any artifact or version change: `just maven-repin`.
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)

# Match the protobuf runtime declared by Record Layer 4.14.2.0, even when
# another module contributes a newer protobuf artifact to this Maven install.
maven.artifact(
    artifact = "protobuf-java",
    force_version = True,
    group = "com.google.protobuf",
    version = "3.25.9",
)
maven.artifact(
    artifact = "protobuf-java-util",
    force_version = True,
    group = "com.google.protobuf",
    version = "3.25.9",
)
use_repo(maven, "maven")

register_toolchains(
    "//tools/javaprotobuf:java_toolchain",
    "//tools/javaprotobuf:unsupported_java_toolchain",
)

# SIFT-1M benchmark dataset (industry-standard ANN benchmark, ~160MB compressed).
# Downloaded on demand via FTP from INRIA TEXMEX. Cached by Bazel repository cache.
# Only fetched when sift_benchmark_test target is built (manual tag).
sift_dataset = use_repo_rule("//:sift_repo.bzl", "sift_dataset")

sift_dataset(name = "sift1m")

# ANTLR4 complete jar (standalone executable with the Tool main class).
# Used by //pkg/relational/core/parser/grammar:generate_parser to regenerate
# the Go parser from the .g4 grammar files. Pin must match the antlr4-go
# runtime declared in go.mod (github.com/antlr4-go/antlr/v4).
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "java_protoc_linux_x86_64",
    downloaded_file_path = "protoc",
    executable = True,
    sha256 = "277c8548ead748ac3e600d3b860f114d36a1311dff29568cd95115ad65f59e2f",
    urls = ["https://repo1.maven.org/maven2/com/google/protobuf/protoc/3.25.9/protoc-3.25.9-linux-x86_64.exe"],
)

http_file(
    name = "antlr4_tool_jar",
    downloaded_file_path = "antlr-4.13.1-complete.jar",
    sha256 = "bc13a9c57a8dd7d5196888211e5ede657cb64a3ce968608697e4f668251a8487",
    urls = ["https://www.antlr.org/download/antlr-4.13.1-complete.jar"],
)

# Source-only oracle for regenerating the frozen Unicode-15 runtime snapshot.
http_file(
    name = "unicode15_xtext_source",
    downloaded_file_path = "text-v0.42.0.zip",
    sha256 = "a7b64e003056b6470303f408202098d8f3714a115f23091b8cac85edeb265476",
    urls = ["https://proxy.golang.org/golang.org/x/text/@v/v0.42.0.zip"],
)

# FDB Python client — the reference binding the binding tester drives our
# stacktester against. It is fetched here rather than assumed present on the
# host: relying on a host `pip install foundationdb` is what silently blanked
# the nightly binding-stress lane (every runner in the fleet lacks the module,
# and the harness reported only "exit status 1").
#
# The released sdist is used, NOT @foundationdb//:python_fdb (the in-tree
# bindings/python/fdb): in the source tree apiversion.py is a CMake template and
# fdboptions.py does not exist at all — it is generated from fdb.options by
# vexillographer at build time. Only the sdist carries a complete package.
# Version tracks the C client pin (bazel_dep foundationdb + .bazelrc FDB_VERSION).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The runtime jar also contains the matching well-known .proto sources. Only
# Java's proto graph uses these; native codegen keeps the protobuf module pin.
http_archive(
    name = "java_protobuf_wkt",
    build_file = "//tools/javaprotobuf:wkt.BUILD.bazel",
    sha256 = "df18b719cd0c5a11e569013216cc9de47a0a954adeede685c0f98ce4c42d4d1a",
    type = "zip",
    urls = ["https://repo1.maven.org/maven2/com/google/protobuf/protobuf-java/3.25.9/protobuf-java-3.25.9.jar"],
)

http_archive(
    name = "fdb_python",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "fdb_srcs",
    srcs = glob(["fdb/*.py"]),
)
""",
    sha256 = "60ffda04fd49968b5c992104160b2147d04e55bdddeaa5d5e78c7f0baf0d211d",
    strip_prefix = "foundationdb-7.3.77",
    urls = ["https://files.pythonhosted.org/packages/cd/b7/9b3de7fcc3280cb7661499bd8889882de7bafbda6153b4bc408ac2faadbe/foundationdb-7.3.77.tar.gz"],
)

# Official generated C headers; the release omits fdb_c_types.h, taken from the same source pin.
http_archive(
    name = "fdb_c_headers",
    build_file_content = """\
load("@rules_cc//cc:cc_library.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])

genrule(
    name = "types_header",
    srcs = ["@foundationdb//:bindings/c/foundationdb/fdb_c_types.h"],
    outs = ["fdb_c_types.h"],
    cmd = "cp $(location @foundationdb//:bindings/c/foundationdb/fdb_c_types.h) $@",
)

cc_library(
    name = "headers",
    hdrs = [
        "fdb_c.h",
        "fdb_c_apiversion.g.h",
        "fdb_c_options.g.h",
        ":types_header",
    ],
    include_prefix = "foundationdb",
)
""",
    sha256 = "73b1efca62bf1779e0d4d62131514c96f689db82865695618086e73a057ea385",
    urls = ["https://github.com/apple/foundationdb/releases/download/7.3.77/fdb-headers-7.3.77.tar.gz"],
)

# libfdb_c 7.3.77 for the Java conformance server; fdb-java 7.1.26 (pinned in maven_install.json,
# a transitive dependency of the Record Layer) runs on it because the C API is backward compatible. The host still provides liblzma.so.5.
http_file(
    name = "libfdb_c_linux_x86_64",
    downloaded_file_path = "libfdb_c.so",
    sha256 = "617572467897d0360f76ffc33f24b58090ee691e3273750d2ff334cc71aae3fa",
    urls = ["https://github.com/apple/foundationdb/releases/download/7.3.77/libfdb_c.x86_64.so"],
)
