+func TestRev5ResurrectionRenewalAgainstCollectedNode(t *testing.T) {
+	for _, stage := range []string{"popped-before-weak-read", "immutable-ready-record"} {
+		t.Run(stage, func(t *testing.T) {
+			q, clock := rev4Queue()
+			old, keeper, resurrected, finished := rev5FinalizableTransaction(q)
+			parked, resume, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			resumeOwner := sync.OnceFunc(func() { close(resume) })
+			defer resumeOwner()
+			paused := false
+			pause := func() {
+				if !paused {
+					paused = true
+					close(parked)
+					<-resume
+				}
+			}
+			if stage == "popped-before-weak-read" {
+				q.root.afterPop = func(n *timeoutNode) {
