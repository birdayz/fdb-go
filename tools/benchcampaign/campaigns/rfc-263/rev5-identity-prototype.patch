+	done := make(chan struct{})
+	go func() {
+		rev4Arm(tx, q, int64(100*time.Second))
+		tx.readErrMu.Lock()
+		tx.disarmTimeoutLocked()
+		tx.readErrMu.Unlock()
+		close(done)
