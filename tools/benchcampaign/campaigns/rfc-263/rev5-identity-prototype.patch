+type rev4ManualTimer struct{}
+
+func (rev4ManualTimer) request(time.Duration) {}
+func rev4Queue() (*timeoutQueue, *atomic.Int64) {
+	c := &atomic.Int64{}
+	q := newTimeoutQueue()
+	for _, shard := range q.root.shards {
+		shard.now = c.Load
+		shard.timer = rev4ManualTimer{}
+	}
+	return q, c
+}
+
+func rev4Arm(tx *Transaction, q *timeoutQueue, deadline int64) {
+	tx.readErrMu.Lock()
+	defer tx.readErrMu.Unlock()
+	tx.timeoutArmed = true
+	tx.timeoutArm++
+	if tx.timeoutNode == nil {
+		tx.timeoutNode = q.newNode(tx)
+	}
+	tx.timeoutNode.queue.schedule(tx.timeoutNode, tx.timeoutArm, deadline)
+}
