+func TestRev5ResurrectionAfterWeakNilDispatch(t *testing.T) {
+	q, clock := rev4Queue()
+	old, keeper, resurrected, finished := rev5FinalizableTransaction(q)
+	held := rev5Resurrect(t, keeper, resurrected, finished, old)
+	clock.Store(old.deadline + int64(100*time.Microsecond))
+	q.fire()
+	old.queue.mu.Lock()
+	gone := old.index == -1 && !old.queued.Load()
+	old.queue.mu.Unlock()
+	if !gone {
+		t.Fatal("weak-nil dispatch did not drop the old physical node")
+	}
+	held.readErrMu.Lock()
+	idleCause := held.readLife.cause
+	held.readErrMu.Unlock()
+	if idleCause != nil {
+		t.Fatalf("inherited idle-resurrection boundary unexpectedly delivered: %v", idleCause)
+	}
+	fresh := rev5Renew(t, held, old)
+	rev5RequireRenewedDelivery(t, q, clock, held, old, fresh)
+}
