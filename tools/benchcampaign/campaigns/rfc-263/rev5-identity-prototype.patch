+func TestRev5ResurrectionReset(t *testing.T) {
+	q, clock := rev4Queue()
+	old, keeper, resurrected, finished := rev5FinalizableTransaction(q)
+	held := rev5Resurrect(t, keeper, resurrected, finished, old)
+	created := held.creationTime
+	held.Reset()
+	if !held.creationTime.After(created) || held.timeoutNs.Load() != int64(30*time.Second) {
+		t.Fatal("Reset did not restart creation time and restore the positive database timeout")
+	}
+	fresh := rev5RequireRenewal(t, held, old, held.creationTime.Add(30*time.Second))
+	rev5RequireRenewedDelivery(t, q, clock, held, old, fresh)
+}
