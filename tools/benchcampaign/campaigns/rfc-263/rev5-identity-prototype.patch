+func TestRev4GlobalDrainerCallbackRescans(t *testing.T) {
+	q, clock := rev4Queue()
+	a, b, c := &Transaction{}, &Transaction{}, &Transaction{}
+	rev4Arm(a, q, int64(time.Millisecond))
+	rev4Arm(b, q, int64(time.Millisecond))
