+func (p Phase) measurementFences() (map[string]any, error) {
+	if p.Started.IsZero() || p.Ended.IsZero() || p.WallNS <= 0 || p.Completed <= 0 || p.Errors != 0 ||
+		p.Ended.Sub(p.Started).Nanoseconds() != p.WallNS || p.Ended.UnixNano() <= p.Started.UnixNano() {
+		return nil, errors.New("invalid measured phase fences")
+	}
+	return map[string]any{
+		"measured_fences_format":   "fdb-bench-measured-fences/v1",
+		"measured_started_unix_ns": p.Started.UnixNano(),
+		"measured_ended_unix_ns":   p.Ended.UnixNano(),
+		"measured_started_utc":     p.Started.UTC().Format(time.RFC3339Nano),
+		"measured_ended_utc":       p.Ended.UTC().Format(time.RFC3339Nano),
