+func TestRunMeasurementFencesAgainstRealFDB(t *testing.T) {
+	if mode := os.Getenv("CLIENTBENCH_FENCE_CHILD"); mode != "" {
+		runMeasurementFenceChild(t, mode)
+		return
+	}
+	// Each child owns a native network; StopNetwork is terminal for that process.
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	container, err := foundationdb.Run(ctx, "", foundationdb.WithDirectIP())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		stop, cancelStop := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancelStop()
+		if err := foundationdb.Terminate(stop, container); err != nil {
+			t.Error(err)
+		}
+	})
+	cluster, err := container.ClusterFilePath(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"positive", "zero"} {
+		if !t.Run(mode, func(t *testing.T) {
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestRunMeasurementFencesAgainstRealFDB$", "-test.v")
+			cmd.Env = append(os.Environ(), "CLIENTBENCH_FENCE_CHILD="+mode,
+				"CLIENTBENCH_FENCE_CLUSTER="+cluster, "GOMAXPROCS=2")
+			text, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("real CGo fence child %s failed: %v\n%s", mode, err, text)
+			}
+			if !strings.Contains(string(text), "CLIENTBENCH_REAL_FENCE "+mode+" completed=1 errors=0 persisted=ok lifecycle=complete") {
+				t.Fatalf("missing real CGo fence child population %s:\n%s", mode, text)
+			}
+			t.Logf("%s", text)
+		}) {
+			return
+		}
+	}
+}
