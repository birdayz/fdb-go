+func TestControlKeepsDescriptorAliveUntilReturn(t *testing.T) {
+	t.Parallel()
+	tm := newTimer(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	resume := func() { once.Do(func() { close(release) }) }
+	t.Cleanup(resume)
+	controlled := make(chan error, 1)
+	go func() {
+		var kernelErr error
+		err := tm.rc.Control(func(fd uintptr) {
+			close(entered)
+			<-release
+			var current unix.ItimerSpec
+			kernelErr = unix.TimerfdGettime(int(fd), &current)
+		})
+		if err == nil {
+			err = kernelErr
+		}
+		controlled <- err
+	}()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Control did not enter its callback")
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- tm.Close() }()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		err := tm.Stop()
+		if errors.Is(err, ErrClosed) {
+			break // Close has marked the file closing while Control still holds it.
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("Close did not enter its closing state")
+		}
+		runtime.Gosched()
+	}
+	select {
+	case err := <-closed:
+		t.Fatalf("Close returned before Control released its descriptor: %v", err)
+	default:
+	}
+	resume()
+	select {
+	case err := <-controlled:
+		if err != nil {
+			t.Fatalf("descriptor died inside Control: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Control did not return")
+	}
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close did not finish after Control returned")
+	}
+}
