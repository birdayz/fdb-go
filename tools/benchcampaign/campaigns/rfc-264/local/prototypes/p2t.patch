+func TestZeroTimerReportsErrClosed(t *testing.T) {
+	t.Parallel()
+	var tm Timer
+	if err := tm.Reset(time.Millisecond); !errors.Is(err, ErrClosed) {
+		t.Fatalf("zero timer Reset = %v, want ErrClosed", err)
+	}
+	if err := tm.Stop(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("zero timer Stop = %v, want ErrClosed", err)
+	}
+}
