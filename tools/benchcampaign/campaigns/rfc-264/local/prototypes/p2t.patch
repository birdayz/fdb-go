+func TestClosedTimerCannotModifyReusedDescriptor(t *testing.T) {
+	// Exclusive: parallel file creation could consume the descriptor being reused.
+	tm := newTimer(t)
+	var originalFD int
+	if err := tm.rc.Control(func(fd uintptr) { originalFD = int(fd) }); err != nil {
+		t.Fatal(err)
+	}
+	if err := tm.Close(); err != nil {
+		t.Fatal(err)
+	}
+	replacement := newTimer(t)
+	var replacementFD int
+	if err := replacement.rc.Control(func(fd uintptr) { replacementFD = int(fd) }); err != nil {
+		t.Fatal(err)
+	}
+	if replacementFD != originalFD {
+		t.Fatalf("descriptor reuse precondition: original=%d replacement=%d", originalFD, replacementFD)
+	}
+	if err := replacement.Reset(time.Hour); err != nil {
+		t.Fatal(err)
+	}
+	if err := tm.Reset(time.Nanosecond); !errors.Is(err, ErrClosed) {
+		t.Fatalf("stale Reset on reused descriptor = %v, want ErrClosed", err)
+	}
+	if err := tm.Stop(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("stale Stop on reused descriptor = %v, want ErrClosed", err)
+	}
+	var current unix.ItimerSpec
+	var kernelErr error
+	if err := replacement.rc.Control(func(fd uintptr) {
+		kernelErr = unix.TimerfdGettime(int(fd), &current)
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if kernelErr != nil || current.Value.Sec < 30*60 || current.Interval != (unix.Timespec{}) {
+		t.Fatalf("stale timer modified replacement: current=%+v err=%v", current, kernelErr)
+	}
+	if err := replacement.Reset(time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-waitAsync(replacement):
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("replacement descriptor no longer delivers expiry")
+	}
+}
