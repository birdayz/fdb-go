+func TestResetClearsUnreadExpiry(t *testing.T) {
+	t.Parallel()
+	tm := newTimer(t)
+	if err := tm.Reset(time.Nanosecond); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	var pollErr error
+	var readable bool
+	if err := tm.rc.Control(func(fd uintptr) {
+		poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN}}
+		for time.Now().Before(deadline) {
+			var n int
+			n, pollErr = unix.Poll(poll, int(time.Until(deadline)/time.Millisecond)+1)
+			if errors.Is(pollErr, unix.EINTR) {
+				continue
+			}
+			readable = n == 1 && poll[0].Revents&unix.POLLIN != 0
+			return
+		}
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if pollErr != nil || !readable {
+		t.Fatalf("expiry was not positively readable: readable=%t err=%v", readable, pollErr)
+	}
+	if err := tm.Reset(time.Hour); err != nil {
+		t.Fatal(err)
+	}
+	if err := tm.rc.Control(func(fd uintptr) {
+		poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN}}
+		var n int
+		n, pollErr = unix.Poll(poll, 0)
+		readable = n != 0
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if pollErr != nil || readable {
+		t.Fatalf("Reset retained old expiry: readable=%t err=%v", readable, pollErr)
+	}
+	if err := tm.Reset(time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-waitAsync(tm):
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("new expiry did not wake Wait after replacing unread readiness")
+	}
+}
