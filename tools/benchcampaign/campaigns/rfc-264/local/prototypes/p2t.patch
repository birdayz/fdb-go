+func TestResetStopRaceClose(t *testing.T) {
+	t.Parallel()
+	const rounds, attempts = 16, 64
+	type result struct {
+		success, closed int
+		err             error
+	}
+	var success, closed int
+	for round := range rounds {
+		tm := newTimer(t)
+		if err := tm.Reset(time.Hour); err != nil {
+			t.Fatal(err)
+		}
+		if err := tm.Stop(); err != nil {
+			t.Fatal(err)
+		}
+		waited := waitAsync(tm)
+		start := make(chan struct{})
+		started := make(chan error, 2)
+		run := func(operation func() error) <-chan result {
+			done := make(chan result, 1)
+			go func() {
+				var r result
+				err := operation()
+				started <- err
+				if err == nil {
+					r.success++
+				} else {
+					r.err = err
+				}
+				<-start
+				for range attempts - 1 {
+					err := operation()
+					switch {
+					case err == nil:
+						r.success++
+					case errors.Is(err, ErrClosed):
+						r.closed++
+					default:
+						r.err = err
+					}
+				}
+				done <- r
+			}()
+			return done
+		}
+		reset := run(func() error { return tm.Reset(time.Hour) })
+		stop := run(tm.Stop)
+		for range 2 {
+			select {
+			case err := <-started:
+				if err != nil {
+					close(start)
+					t.Fatalf("round %d: control before Close = %v", round, err)
+				}
+			case <-time.After(5 * time.Second):
+				close(start)
+				t.Fatalf("round %d: initial control did not return", round)
+			}
+		}
+		close(start)
+		if err := tm.Close(); err != nil {
+			t.Fatal(err)
+		}
+		for _, done := range []<-chan result{reset, stop} {
+			select {
+			case r := <-done:
+				if r.err != nil || r.success == 0 || r.success+r.closed != attempts {
+					t.Fatalf("round %d: incomplete or invalid control results: %+v", round, r)
+				}
+				success += r.success
+				closed += r.closed
+			case <-time.After(5 * time.Second):
+				t.Fatalf("round %d: control did not return after Close", round)
+			}
+		}
+		for _, err := range []error{tm.Reset(time.Hour), tm.Stop()} {
+			if !errors.Is(err, ErrClosed) {
+				t.Fatalf("round %d: post-close control = %v, want ErrClosed", round, err)
+			}
+		}
+		select {
+		case err := <-waited:
+			if !errors.Is(err, ErrClosed) {
+				t.Fatalf("round %d: Wait after Close = %v, want ErrClosed", round, err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatalf("round %d: Close did not wake Wait", round)
+		}
+	}
+	t.Logf("%d rounds, %d raced controls: %d succeeded, %d ErrClosed; %d post-close checks", rounds, 2*rounds*attempts, success, closed, 2*rounds)
+}
