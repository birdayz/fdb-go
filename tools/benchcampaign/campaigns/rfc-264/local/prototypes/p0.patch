+// pendingReplyWriteGate forwards one actual GetValue frame, then holds Write's
+// return. The real reply can therefore be published while the writer still owns
+// its bytes and any later Flush marker remains behind it.
+type pendingReplyWriteGate struct {
+	key            []byte
+	armed          atomic.Bool
+	parked         chan struct{}
+	failed         chan error
+	release        chan struct{}
+	once           sync.Once
+	mu             sync.Mutex
+	bodyErr        error
+	writeErr       error
+	injected       atomic.Bool
+	expiredVersion bool
+	rewritten      atomic.Bool
+}
+
+func (g *pendingReplyWriteGate) releaseIt() { g.once.Do(func() { close(g.release) }) }
+
+func (g *pendingReplyWriteGate) fail(err error) (int, error) {
+	select {
+	case g.failed <- err:
+	default:
+	}
+	return 0, err
+}
+
+func (g *pendingReplyWriteGate) dial(ctx context.Context, network, addr string) (net.Conn, error) {
+	c, err := (&net.Dialer{}).DialContext(ctx, network, addr)
+	if err != nil {
+		return nil, err
+	}
+	return &pendingReplyWriteConn{Conn: c, gate: g, hello: transport.ConnectPacketSize}, nil
+}
+
+type pendingReplyWriteConn struct {
+	net.Conn
+	gate    *pendingReplyWriteGate
+	hello   int
+	pending []byte
+	blocked atomic.Bool
+}
+
+func (c *pendingReplyWriteConn) Write(p []byte) (int, error) {
+	incoming := p
+	if c.hello > 0 {
+		n := min(c.hello, len(incoming))
+		c.hello -= n
+		incoming = incoming[n:]
+	}
+	frameStart := len(p) - len(incoming) - len(c.pending)
+	c.pending = append(c.pending, incoming...)
+	for len(c.pending) >= 4 {
+		length := int(binary.LittleEndian.Uint32(c.pending)) + 12
+		if length < 28 || length > 100<<20+12 {
+			return c.gate.fail(fmt.Errorf("invalid outbound frame length %d", length))
+		}
+		if len(c.pending) < length {
+			break
+		}
+		token, body, err := transport.ReadFrame(bytes.NewReader(c.pending[:length]), false)
+		if err != nil {
+			return c.gate.fail(err)
+		}
+		start, end := frameStart, frameStart+length
+		frameStart = end
+		c.pending = c.pending[length:]
+		// StorageServerInterface.h: GetValueRequest::file_identifier.
+		if len(body) < 8 || binary.LittleEndian.Uint32(body[4:8]) != 8454530 {
+			continue
+		}
+		var request types.GetValueRequest
+		if err := request.UnmarshalFDB(body); err != nil {
+			return c.gate.fail(err)
+		}
+		if !bytes.Equal(request.Key, c.gate.key) || !c.gate.armed.CompareAndSwap(true, false) {
+			continue
+		}
+		forward := p
+		if c.gate.expiredVersion {
+			if start < 0 || end > len(p) {
+				return c.gate.fail(errors.New("target GetValue frame was split across Write calls"))
+			}
+			// Change only the forwarded copy. waitForVersion rejects version
+			// <= 0 unconditionally (storageserver.actor.cpp:2271–2273), unlike
+			// version 1, which can still exist on a fresh storage server.
+			vector := request.SsLatestCommitVersions
+			// Canonical empty VersionVector: uint64 count=0, int64 max=-1.
+			if len(vector) != 16 || binary.LittleEndian.Uint64(vector[:8]) != 0 || binary.LittleEndian.Uint64(vector[8:]) != ^uint64(0) {
+				return c.gate.fail(errors.New("target GetValue unexpectedly carries a nonempty commit-version vector"))
+			}
+			request.Version = 0
+			var frame bytes.Buffer
+			if err := transport.WriteFrame(&frame, token, request.MarshalFDB(), false); err != nil {
+				return c.gate.fail(err)
+			}
+			forward = append(bytes.Clone(p[:start]), frame.Bytes()...)
+			forward = append(forward, p[end:]...)
+			c.gate.rewritten.Store(true)
+		}
+		c.blocked.Store(true)
+		before := bytes.Clone(p)
+		n, writeErr := c.Conn.Write(forward)
+		if writeErr == nil && n != len(forward) {
+			writeErr = io.ErrShortWrite
+		}
+		if writeErr != nil {
+			c.gate.mu.Lock()
+			c.gate.bodyErr = fmt.Errorf("forward actual GetValue: %w", writeErr)
+			c.gate.mu.Unlock()
+		}
+		close(c.gate.parked)
+		<-c.gate.release
+		if !bytes.Equal(before, p) {
+			c.gate.mu.Lock()
+			c.gate.bodyErr = errors.New("accepted GetValue bytes changed before Write returned")
+			c.gate.mu.Unlock()
+			return n, io.ErrUnexpectedEOF
+		}
+		if writeErr == nil {
+			n = len(p) // the successful forwarded fault copy can have a different size
+			writeErr = c.gate.writeErr
+			c.gate.injected.Store(writeErr != nil)
+		}
+		return n, writeErr
+	}
+	return c.Conn.Write(p)
+}
+
+func (c *pendingReplyWriteConn) Close() error {
+	if c.blocked.Load() {
+		c.gate.releaseIt()
+	}
+	return c.Conn.Close()
+}
