+func TestPendingGet_ReadyReplyBeforeWriteAcknowledgment(t *testing.T) {
+	t.Parallel()
+	for _, replyError := range []bool{false, true} {
+		for _, mode := range []string{"plain", "expired-timer", "closed-abort", "caller-cancel", "transaction-cancel", "reset", "late-write-error"} {
+			t.Run(fmt.Sprintf("error-%t/%s", replyError, mode), func(t *testing.T) {
+				t.Parallel()
+				ctx, cancel := context.WithTimeout(context.Background(), readIncarnationTestTimeout)
+				defer cancel()
+				key := []byte(t.Name())
+				want := []byte("published-real-peer-value")
+				gate := &pendingReplyWriteGate{key: key, parked: make(chan struct{}), failed: make(chan error, 1), release: make(chan struct{}), expiredVersion: replyError}
+				if mode == "late-write-error" {
+					gate.writeErr = io.ErrUnexpectedEOF
+				}
+				db := newTestDatabase(t, ctx, sharedClusterFile, gate.dial)
+				t.Cleanup(func() { _ = db.Close() })
+				t.Cleanup(gate.releaseIt)
+				rv := seedReadIncarnationValues(t, ctx, db, key, append(bytes.Clone(key), 'b'), want, []byte("other"))
+				tx := db.CreateTransaction()
+				tx.SetReadVersion(rv)
+				readCtx, stopRead := context.WithCancel(ctx)
+				defer stopRead()
+				gate.armed.Store(true)
+				_, pending, err := tx.GetPipelined(readCtx, key)
+				if err != nil || pending == nil {
+					t.Fatalf("GetPipelined pending=%v err=%v", pending, err)
+				}
+				select {
+				case <-gate.parked:
+				case err := <-gate.failed:
+					t.Fatalf("prepare real GetValue forwarding gate: %v", err)
+				case <-ctx.Done():
+					t.Fatal("actual GetValue never reached the forwarding gate")
+				}
+				gate.mu.Lock()
+				forwardErr := gate.bodyErr
+				gate.mu.Unlock()
+				if forwardErr != nil {
+					t.Fatal(forwardErr)
+				}
+				if gate.rewritten.Load() != replyError {
+					t.Fatal("expired-version forwarding fault did not match the test case")
+				}
+				tick := time.NewTicker(time.Millisecond)
+				defer tick.Stop()
+				for len(pending.replyCh) == 0 {
+					select {
+					case <-tick.C:
+					case <-ctx.Done():
+						t.Fatal("the real peer response was not published while Write return was held")
+					}
+				}
+
+				// Positively park an independent Flush marker. Early resolution must
+				// not release the writer's credit or manufacture its acknowledgment.
+				witness := &writeWaitWitness{Context: ctx, queued: make(chan struct{})}
+				flushed := make(chan error, 1)
+				flushJoined := false
+				go func() { flushed <- pending.conn.FlushContext(witness) }()
+				t.Cleanup(func() {
+					gate.releaseIt()
+					if !flushJoined {
+						select {
+						case <-flushed:
+						case <-time.After(5 * time.Second):
+							t.Error("flush worker did not join after gate release")
+						}
+					}
+				})
+				waitReadParked(t, ctx, witness.queued, "flush marker behind the forwarded request")
+				putTimer(pending.timer)
+				pending.timer = getTimer(time.Hour)
+				// Observe a regression's own Flush wait directly, before a monitor
+				// timeout could close the connection and accidentally release it.
+				var ownWait *transport.SuspendSignal
+				pending.ctx, ownWait = transport.WithSuspendSignal(pending.ctx)
+				t.Cleanup(ownWait.Fire)
+				var abort <-chan struct{}
+				switch mode {
+				case "expired-timer":
+					pending.timer.Reset(0) // due when the ready-arm select is polled
+				case "closed-abort":
+					closed := make(chan struct{})
+					close(closed)
+					abort = closed
+				case "caller-cancel":
+					stopRead()
+				case "transaction-cancel":
+					tx.Cancel()
+				case "reset":
+					tx.Reset()
+				}
+				type outcome struct {
+					value     []byte
+					err       error
+					abandoned bool
+				}
+				done := make(chan outcome, 1)
+				resolveJoined := false
+				go func() {
+					value, err, abandoned := pending.ResolveOrAbort(abort)
+					done <- outcome{value, err, abandoned}
+				}()
+				t.Cleanup(func() {
+					gate.releaseIt()
+					if !resolveJoined {
+						select {
+						case <-done:
+						case <-time.After(5 * time.Second):
+							t.Error("resolver worker did not join after gate release")
+						}
+					}
+				})
+				var got outcome
+				select {
+				case got = <-done:
+					resolveJoined = true
+				case <-ownWait.Done():
+					t.Fatal("already-published Get entered a transport wait before resolving")
+				case <-time.After(10 * time.Second):
+					gate.releaseIt()
+					t.Fatal("already-published Get waited for the held Write acknowledgment")
+				}
+				select {
+				case <-ownWait.Done():
+					t.Fatal("already-published Get entered a transport wait before resolving")
+				default:
+				}
+				if got.abandoned {
+					t.Fatal("an already-published response lost to the abort arm")
+				}
+				if replyError {
+					if fdbCodeOf(got.err) != 1007 {
+						t.Fatalf("ready real-peer error = %v, want code 1007", got.err)
+					}
+				} else if got.err != nil || !bytes.Equal(got.value, want) {
+					t.Fatalf("ready value=%q err=%v, want %q", got.value, got.err, want)
+				}
+				select {
+				case <-gate.release:
+					t.Fatal("Write returned before the ready response resolved")
+				case err := <-flushed:
+					flushJoined = true
+					t.Fatalf("independent flush completed before Write returned: %v", err)
+				default:
+				}
+				if pending.replyHandle != nil || pending.timer != nil || !pending.settledFlag.Load() {
+					t.Fatal("ready resolution retained its reply handle, timer or unsettled state")
+				}
+				gate.releaseIt()
+				select {
+				case err := <-flushed:
+					flushJoined = true
+					if mode == "late-write-error" {
+						if err == nil || !gate.injected.Load() {
+							t.Fatalf("late write failure was not observed: flush=%v injected=%v", err, gate.injected.Load())
+						}
+						waitReadParked(t, ctx, pending.conn.Done(), "late write failure connection teardown")
+					} else if err != nil {
+						t.Fatalf("flush after release: %v", err)
+					}
+				case <-ctx.Done():
+					t.Fatal("writer did not drain after gate release")
+				}
+				gate.mu.Lock()
+				bodyErr := gate.bodyErr
+				gate.mu.Unlock()
+				if bodyErr != nil {
+					t.Fatal(bodyErr)
+				}
+				memoValue, memoErr := pending.Resolve()
+				if !bytes.Equal(memoValue, got.value) || (memoErr == nil) != (got.err == nil) || fdbCodeOf(memoErr) != fdbCodeOf(got.err) {
+					t.Fatalf("ready memo changed after writer retirement: value=%q err=%v, first=%q/%v", memoValue, memoErr, got.value, got.err)
+				}
+				if mode == "reset" {
+					tx.Set(append(bytes.Clone(key), 'c'), []byte("replacement"))
+					if err := tx.Commit(ctx); err != nil {
+						t.Fatalf("old ready response poisoned replacement incarnation: %v", err)
+					}
+				}
+			})
+		}
+	}
+}
