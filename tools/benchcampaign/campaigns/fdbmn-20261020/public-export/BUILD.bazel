filegroup(
    name = "analysis_helpers",
    srcs = [
        "export_public_results.py",
        "export_throughput.py",
        "m2_throughput.py",
        "test_m2_throughput.py",
    ],
    visibility = ["//tools/benchcampaign/campaigns/fdbmn-rfc282:__pkg__"],
)

# Tiny offline fixtures; no private campaign inputs or estimators.
sh_test(
    name = "export_public_results_test",
    srcs = ["test.sh"],
    data = [
        "export_public_results.py",
        "export_throughput.py",
        "m2_throughput.py",
        "test_export_public_results.py",
        "test_m2_throughput.py",
        "test_throughput.py",
    ],
