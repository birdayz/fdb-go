+// m1Open connects to the native cluster named by M1_FDB_CLUSTER_FILE (M1 harness shim).
+func m1Open(b *testing.B) bool {
+	cf := os.Getenv("M1_FDB_CLUSTER_FILE")
+	if cf == "" {
+		if os.Getenv("M1_KEY_PREFIX") != "" {
+			b.Fatal("M1_KEY_PREFIX set without M1_FDB_CLUSTER_FILE")
+		}
+		return false
+	}
+	fdb.MustAPIVersion(730)
+	dbConn, err := fdb.OpenDatabase(cf)
+	if err != nil {
+		b.Fatalf("open %s: %v", cf, err)
+	}
+	sharedDB = NewFDBDatabase(dbConn)
+	return true
+}
+
+// m1ProcCPU reports whole-process CPU (all threads) over the timed loop, per op.
+func m1ProcCPU(b *testing.B) func() {
+	u0, s0 := m1Rusage(b)
+	return func() {
+		u1, s1 := m1Rusage(b)
+		n := float64(b.N)
+		b.ReportMetric(float64(u1-u0+s1-s0)/n, "proc-cpu-ns/op")
+		b.ReportMetric(float64(u1-u0)/n, "proc-user-ns/op")
+		b.ReportMetric(float64(s1-s0)/n, "proc-sys-ns/op")
+	}
+}
+
+func m1Rusage(b *testing.B) (user, sys int64) {
+	var ru syscall.Rusage
+	if err := syscall.Getrusage(syscall.RUSAGE_SELF, &ru); err != nil {
+		b.Fatalf("getrusage: %v", err)
+	}
+	return ru.Utime.Nano(), ru.Stime.Nano()
+}
