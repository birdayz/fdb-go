load("@rules_go//go:def.bzl", "go_binary")

# Each executable contains exactly one client, as for clientbench.
# gazelle:ignore
go_binary(
    name = "wgscen_go",
    srcs = [
        "main.go",
        "open_go.go",
    ],
    pure = "on",
    visibility = ["//visibility:public"],
    deps = ["//pkg/fdbgo/fdb"],
)

go_binary(
    name = "wgscen_cgo",
    srcs = [
        "main.go",
        "open_cgo.go",
    ],
    cgo = True,
    gotags = ["libfdbc"],
    pure = "off",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/libfdbc:libfdbc_native",
    ],
)
