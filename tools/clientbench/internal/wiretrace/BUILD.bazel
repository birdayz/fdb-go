load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//tools/clientbench:__subpackages__"])

go_library(
    name = "wiretrace",
    srcs = [
        "analyze.go",
        "frames.go",
        "pcap.go",
    ],
    importpath = "fdb.dev/tools/clientbench/internal/wiretrace",
    visibility = ["//tools/clientbench:__subpackages__"],
    deps = [
        "//internal/fdbwire",
        "//internal/fdbwire/types",
        "@com_github_zeebo_xxh3//:xxh3",
    ],
)

go_test(
    name = "wiretrace_test",
    srcs = ["wiretrace_test.go"],
    data = ["//internal/fdbwire/types:testdata.json"],
    embed = [":wiretrace"],
    deps = [
        "//internal/fdbwire",
        "//internal/fdbwire/types",
        "@com_github_zeebo_xxh3//:xxh3",
    ],
)
