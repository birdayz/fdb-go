# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace files are intentionally committed — the cmd/frl multi-module
# setup relies on go.work, so every contributor and CI sees the same workspace.


# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# OS files
.DS_Store

# The Java reference checkout, cloned at the repo root. Anchored with a leading
# slash: unanchored, this pattern also swallows the vendored corpus under
# third_party/apple/fdb-record-layer/, which is checked in on purpose.
/fdb-record-layer

# SIFT-1M benchmark data
pkg/recordlayer/testdata/*.fvecs
pkg/recordlayer/testdata/*.ivecs

# Bazel convenience symlinks. Root-anchored glob so it covers every worktree name
# (bazel-bin/out/testlogs and the workspace-named bazel-<dir>, e.g. bazel-review)
# without having to enumerate each — these are machine-local cache links and must
# never be committed.
/bazel-*
.bazel-bep.jsonl
test-report.html
.tools/
pkg/fdbgo/wire/types/v5/
binding-stress-out/
binding-stress-report.txt
bench-raw.txt
bench-results.txt
bench-baseline.txt
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/projects/
test-report.html
REVIEW.md

# transient code-review scratch (codex / reviewer agents)
.review_*.txt
/screenlog.*

# stray build artifact from `go build ./example/sql`
/sql

# Hugo website build output / cache (website/ is the fdb.dev site source)
website/public/
website/resources/
website/.hugo_build.lock
.playwright-mcp/

# ephemeral working notes (belong in /tmp scratchpad or shifts/ handovers)
scratchpad/

# Stray `go build ./cmd/<x>` output at the repo root. `go build` with no -o
# drops the binary in the CWD, and `git add -A` then commits several MB of it.
# Add a line here for any new cmd/ binary whose name could land at the root.
/fuzzrun
/fdb-wire-emit

# compiled binaries (stray go build outputs)
/factory-run
/factory-migrate
/test-budget

# scratch build dir used by local test tooling
.tmpbuild/
/factory-rebless-plan-shapes
/verify-corpus-retirement-history
flake-runs/

# Local, untracked RFC-232 session handoff (durable findings belong in TODO.md).
HANDOFF_RFC232_CLAUDE.md
