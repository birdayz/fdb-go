+		config.M, config.MMax, config.MMax0 = 4, 4, 8
+		config.Quantizer = rabitq.NewQuantizer(rabitq.MetricEuclidean, 4)
+		config.SampleVectorStatsProbability = 1
+		config.MaintainStatsProbability = 1
+		config.StatsThreshold = 1
