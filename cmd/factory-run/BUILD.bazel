load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "factory-run_lib",
    srcs = [
        "javaleg.go",
        "main.go",
    ],
    importpath = "fdb.dev/cmd/factory-run",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/relational/conformance/factory",
        "//pkg/relational/conformance/factorycorpus",
        "//pkg/relational/conformance/plandiff",
        "//pkg/relational/sqldriver",
        "//pkg/testcontainers/foundationdb",
    ],
)

go_binary(
    name = "factory-run",
    embed = [":factory-run_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "factory-run_test",
    srcs = [
        "census_gate_test.go",
        "exit_test.go",
        "persist_test.go",
    ],
    embed = [":factory-run_lib"],
    tags = ["resources:memory:400"],
    deps = [
        "//pkg/relational/conformance/factory",
        "//pkg/relational/conformance/factorycorpus",
        "//pkg/relational/conformance/yamsql",
    ],
)
