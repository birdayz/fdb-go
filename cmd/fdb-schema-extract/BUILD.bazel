# Two-stage schema extractor with proper Bazel caching.
#
# Stage 1 (fdb_cmake_build): cmake + ninja fdbclient inside Docker.
#   Input: pinned FDB source/image/build options. Output: tar of build dir.
#
# Stage 2 (generate_wire_types): compile + run schema_extract inside Docker.
#   Input: stage 1 tar + main.cpp + extract.h. Output: generated Go files tar.
#   Cached independently when generator code changes.
#
# Run: just generate-wire-types

load(":fdb_cpp_build.bzl", "fdb_cpp_build", "fdb_cpp_resources")

# Larger machines can opt in with --//cmd/fdb-schema-extract:resources=large.
fdb_cpp_resources(
    name = "resources",
    build_setting_default = "compact",
    visibility = ["//visibility:public"],
)

fdb_cpp_build(
    name = "fdb_cmake_build",
    srcs = [
        "@foundationdb//:CMakeLists.txt",
        "@foundationdb//:all_srcs",
    ],
    outs = ["fdb_build.tar"],
    cmd = """
        set -euo pipefail
        FDB_SRC=$$(realpath "$$(dirname "$(location @foundationdb//:CMakeLists.txt)")")
        TMPOUT=$$(mktemp -d)
        IMAGE="$(FDB_BUILD_IMAGE)"
        cleanup() {
            if [ -f "$$TMPOUT/container.cid" ]; then
                docker rm -f "$$(cat "$$TMPOUT/container.cid")" >/dev/null 2>&1 || true
            fi
            rm -rf "$$TMPOUT"
        }
        trap cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        chmod 777 "$$TMPOUT"

        docker run --rm --cidfile="$$TMPOUT/container.cid" \
            --cpus=$(FDB_BUILD_CPUS) --memory=$(FDB_BUILD_MEMORY_MB)m --memory-swap=$(FDB_BUILD_MEMORY_MB)m \
            -v "$$FDB_SRC:/fdb_src:ro" \
            -v "$$TMPOUT:/out" \
            "$$IMAGE" \
            bash -c '
                set -eo pipefail
                report_resources() {
                    status=$$?
                    if [ "$$status" -ne 0 ] && [ -f /out/build.log ]; then
                        cat /out/build.log
                    fi
                    for stat in memory.peak memory.events cpu.stat; do
                        if [ -r /sys/fs/cgroup/$$stat ]; then
                            echo "FDB C++ resource usage: $$stat"
                            cat /sys/fs/cgroup/$$stat
                        fi
                    done
                }
                trap report_resources EXIT
                source /opt/rh/gcc-toolset-13/enable
                cp -r /fdb_src /tmp/fdb
                sed -i "s/package_bindingtester/#package_bindingtester/" /tmp/fdb/bindings/CMakeLists.txt 2>/dev/null || true

                cmake -S /tmp/fdb -B /tmp/build -G Ninja \
                    -DCMAKE_BUILD_TYPE=Release \
                    -DCMAKE_CXX_FLAGS_RELEASE="$(FDB_CXX_FLAGS)" \
                    -DBUILD_PYTHON_BINDING=OFF -DBUILD_C_BINDING=ON \
                    -DBUILD_JAVA_BINDING=OFF -DBUILD_GO_BINDING=OFF \
                    -DBUILD_SWIFT_BINDING=OFF -DBUILD_RUBY_BINDING=OFF \
                    -DBUILD_DOCUMENTATION=OFF -DWITH_CSHARP=OFF \
                    -DWITH_PYTHON=OFF -DUSE_WERROR=OFF -DBUILD_TESTING=OFF \
                    2>&1 | tee /out/build.log | tail -3

                ninja -C /tmp/build -j$(FDB_BUILD_CPUS) fdbclient 2>&1 | tee /out/build.log | tail -3
                tar cf /out/fdb_build.tar -C /tmp build fdb
                chmod 666 /out/fdb_build.tar
            '

        mv "$$TMPOUT/fdb_build.tar" $@
    """,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

fdb_cpp_build(
    name = "generate_wire_types",
    srcs = [
        "extract.h",
        "main.cpp",
        ":fdb_cmake_build",
    ],
    outs = ["wire_types.tar"],
    cmd = """
        set -euo pipefail
        BUILD_TAR=$$(realpath $(location :fdb_cmake_build))
        MAIN_CPP=$$(realpath $(location main.cpp))
        EXTRACT_H=$$(realpath $(location extract.h))
        TMPOUT=$$(mktemp -d)
        IMAGE="$(FDB_BUILD_IMAGE)"
        cleanup() {
            if [ -f "$$TMPOUT/container.cid" ]; then
                docker rm -f "$$(cat "$$TMPOUT/container.cid")" >/dev/null 2>&1 || true
            fi
            rm -rf "$$TMPOUT"
        }
        trap cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        chmod 777 "$$TMPOUT"

        docker run --rm --cidfile="$$TMPOUT/container.cid" \
            --cpus=$(FDB_BUILD_CPUS) --memory=$(FDB_BUILD_MEMORY_MB)m --memory-swap=$(FDB_BUILD_MEMORY_MB)m \
            -v "$$BUILD_TAR:/in/build.tar:ro" \
            -v "$$MAIN_CPP:/in/main.cpp:ro" \
            -v "$$EXTRACT_H:/in/extract.h:ro" \
            -v "$$TMPOUT:/out" \
            "$$IMAGE" \
            bash -c '
                set -eo pipefail
                report_resources() {
                    status=$$?
                    if [ "$$status" -ne 0 ] && [ -f /out/build.log ]; then
                        cat /out/build.log
                    fi
                    for stat in memory.peak memory.events cpu.stat; do
                        if [ -r /sys/fs/cgroup/$$stat ]; then
                            echo "FDB C++ resource usage: $$stat"
                            cat /sys/fs/cgroup/$$stat
                        fi
                    done
                }
                trap report_resources EXIT
                source /opt/rh/gcc-toolset-13/enable
                cd /tmp && tar xf /in/build.tar

                cp /in/main.cpp /tmp/fdb/schema_extract_main.cpp
                cp /in/extract.h /tmp/fdb/extract.h
                touch /tmp/fdb/schema_extract_main.cpp /tmp/fdb/extract.h

                cat > /tmp/fdb/schema_extract.cmake << "EOF"
add_executable(schema_extract schema_extract_main.cpp)
target_link_libraries(schema_extract PRIVATE fdbclient fdbrpc flow)
target_include_directories(schema_extract PRIVATE
    $${CMAKE_SOURCE_DIR} $${CMAKE_BINARY_DIR}
    $${CMAKE_BINARY_DIR}/fdbclient/include $${CMAKE_BINARY_DIR}/fdbclient
    $${CMAKE_BINARY_DIR}/fdbrpc/include $${CMAKE_BINARY_DIR}/fdbrpc
    $${CMAKE_BINARY_DIR}/flow/include $${CMAKE_BINARY_DIR}/flow)
EOF
                grep -q schema_extract.cmake /tmp/fdb/CMakeLists.txt || \
                    echo "include(schema_extract.cmake)" >> /tmp/fdb/CMakeLists.txt

                ninja -C /tmp/build -j$(FDB_BUILD_CPUS) schema_extract 2>&1 | tee /out/build.log | tail -3
                mkdir -p /out/types
                /tmp/build/bin/schema_extract /out/types
                cd /out && tar cf /out/wire_types.tar types/
                # Fix permissions so host user can read/delete.
                chmod -R a+rwX /out/
            '

        mv "$$TMPOUT/wire_types.tar" $@
    """,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

exports_files([
    "BUILD.bazel",
    "fdb_cpp_build.bzl",
    "main.cpp",
    "extract.h",
    "build.sh",
])
