load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    importpath = "fdb.dev/cmd/fdb/internal/config",
    visibility = ["//cmd/fdb:__subpackages__"],
    deps = [
        "//cmd/fdb/gen/fdb/config/v1:config",
        "@build_buf_go_protoyaml//:protoyaml",
        "@com_github_birdayz_protobuf_ecosystem//protoconfig",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "config_test",
    srcs = [
        "config_test.go",
        "config_write_test.go",
    ],
    embed = [":config"],
    deps = [
        "//cmd/fdb/gen/fdb/config/v1:config",
        "@org_golang_google_protobuf//proto",
    ],
)
