load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

exports_files(["README.md"])

go_library(
    name = "fdb_lib",
    srcs = ["main.go"],
    importpath = "fdb.dev/cmd/fdb",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/fdb/internal/cmd",
        "//pkg/relational/core/keyspace",
        "@land_charm_fang_v2//:fang",
    ],
)

go_binary(
    name = "fdb",
    embed = [":fdb_lib"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "demo_files",
    srcs = [
        "demo/schema.sql",
        "demo/seed.sql",
    ],
    visibility = ["//cmd/fdb:__subpackages__"],
)

go_test(
    name = "fdb_test",
    srcs = ["registry_test.go"],
    embed = [":fdb_lib"],
    deps = [
        "//pkg/relational/sqldriver",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
    ],
)
