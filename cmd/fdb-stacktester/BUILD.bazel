load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "fdb-stacktester_lib",
    srcs = [
        "directory_ops.go",
        "machine.go",
        "main.go",
        "operations.go",
        "transaction_lifetime.go",
    ],
    importpath = "fdb.dev/cmd/fdb-stacktester",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/fdbgo/client",
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/directory",
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/fdbgo/fdb/tuple",
        "//pkg/fdbgo/wire",
        "@com_github_apple_foundationdb_bindings_go//src/fdb",
        "@com_github_apple_foundationdb_bindings_go//src/fdb/tuple",
    ],
)

go_binary(
    name = "fdb-stacktester",
    embed = [":fdb-stacktester_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "fdb-stacktester_test",
    srcs = [
        "arithmetic_test.go",
        "commit_teardown_test.go",
        "directory_context_test.go",
        "directory_panic_test.go",
        "directory_remove_prefix_test.go",
        "directory_unpack_test.go",
        "entrypoint_contract_test.go",
        "metrics_test.go",
        "operations_test.go",
        "split_forwarding_test.go",
        "thread_test.go",
        "tuple_directory_test.go",
    ],
    data = [":fdb-stacktester"],
    embed = [":fdb-stacktester_lib"],
    deps = [
        "//pkg/fdbgo/client",
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/directory",
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/fdbgo/transport",
        "//pkg/fdbgo/wire",
        "//pkg/fdbgo/wire/types",
        "//pkg/testcontainers/foundationdb",
        "@com_github_apple_foundationdb_bindings_go//src/fdb/tuple",
    ],
)
