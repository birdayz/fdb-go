# Don't inherit shell environment into actions — use Bazel's fixed defaults
build --incompatible_strict_action_env

# Use remote JDK — no system Java dependency required
build --java_runtime_version=remotejdk_21

test --test_output=errors
test --test_summary=terse

# Produce Build Event Protocol JSONL for test report generation.
# Read by cmd/test-report to generate HTML reports from JUnit XML.
test --build_event_json_file=.bazel-bep.jsonl

# Verbose test output for report generation. Per-test timing in test.log.
# This IS part of the Bazel action fingerprint — invalidates cache once
# on first run after adding, then stays stable.
test --test_arg="-test.v"

# ...which makes a large suite's output exceed Bazel's default 1 MiB console
# budget, and Bazel DISCARDS an over-budget stream rather than truncating it:
#   stdout (...) 1181390 exceeds maximum size of
#   --experimental_ui_max_stdouterr_bytes=1048576 bytes; skipping
# A red then names nothing at all. The factory corpus already sits past that
# default on a PASSING run — 5000 parallel subtests cost ~1.18 MB in -test.v
# framing lines (RUN/PAUSE/CONT/result) before any failure detail exists — so
# every failure of that target was unrecoverable from the log, and a retry
# overwrites the on-disk test.log. Raise the budget well above the framing
# floor. //pkg/relational/conformance/factorycorpus:factorycorpus_test's
# TestSubtestFramingFitsLogCap reads the value below and fails when the corpus
# grows into it, so this number cannot silently go stale.
test --experimental_ui_max_stdouterr_bytes=16777216

# Testcontainers need Docker socket and HOME for config
test --test_env=HOME

# FDB version — single source of truth for all tests.
# MUST match MODULE.bazel archive_override version.
test --test_env=FDB_VERSION=7.3.77

# Override eternal timeout slot (default 900s → 3600s).
# client_test spawns ~40 FDB containers and needs ~7 min.
test --test_timeout=60,300,900,3600

# Coverage: only instrument our code, not generated types or linters.
# Without this, Bazel auto-instruments everything (including gen/ and
# pkg/linters/) which dilutes the coverage percentage.
coverage --instrumentation_filter="^//pkg/fdbgo/client[/:],^//pkg/fdbgo/fdb[/:],^//pkg/fdbgo/transport[/:],^//pkg/recordlayer[/:]"

# Test scheduling: Bazel's resource accounting, the same on every machine.
# --local_test_jobs=0 charges each test its declared needs instead of a count
# cap: tags = ["resources:cpu:N"] (measured CPU-seconds per wall-second,
# default 1) against HOST_CPUS and ["resources:memory:N"] (measured peak RSS
# in MB) against 80% of RAM. Any non-zero --local_test_jobs makes Bazel ignore
# those tags (measured, Bazel 9.0.1). A need larger than the machine still runs
# (Bazel grants it once enough is free), so a cpu:8 target runs on a 4-vCPU
# box. 0.8 of RAM held 48 concurrent FDB containers with no failure on the
# 24-core / 62 GB dev box; --config=ci lowers it for CI's small runners.
# The old cap of 4 (and the justfile's 8) blamed Docker for hangs past ~8 FDB
# containers; the measured cause was the kernel AIO pool (fs.aio-max-nr)
# exhausted by another service on the dev box, which fdbserver reports as 1510
# "Disk i/o operation failed". With the pool raised, 48 concurrent containers
# ran cleanly.
test --local_test_jobs=0
test --local_resources=cpu=HOST_CPUS
test --local_resources=memory=HOST_RAM*0.8
# `bazelrunfiles`: runfiles-only suites (conformance, bindingtester) — excluded from
#   a plain `go test ./...` so it doesn't panic looking for Bazel runfiles.
# `stress`: heavy million-row stress benchmarks under //pkg/relational/sqldriver/stress.
#   The target is `manual` (runs only when invoked, e.g. by nightly), so setting the tag
#   globally is inert for `bazel test //...`; it just lets that one target compile when
#   invoked. Plain `go test ./...` doesn't set the tag, so it skips the stress package.
build --@rules_go//go/config:tags=bazelrunfiles,stress

# --- CI (every workflow bazelisk invocation passes --config=ci) ---------------
# announce_rc puts the effective flags in every CI log, and makes `ci` a config
# every command accepts (query and info included).
common:ci --announce_rc
test:ci --test_summary=detailed
test:ci --profile=bazel-profile.json.gz
# The 7.6 GB runners hold 0.6 of RAM for tests: 4500 MB measured safe, the
# runner minus its idle baseline (~730 MB) and the Bazel server (~2500 MB).
test:ci --local_resources=memory=HOST_RAM*0.6

# Personal overrides (gitignored), e.g. --test_output=streamed or a disk cache.
try-import %workspace%/user.bazelrc
