load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "docscheck",
    srcs = ["doc.go"],
    importpath = "fdb.dev/pkg/docscheck",
    visibility = ["//visibility:public"],
)

go_test(
    name = "docscheck_test",
    srcs = [
        "accessor_arity_census_test.go",
        "api_parity_options_test.go",
        "build_constrained_filename_test.go",
        "build_membership_test.go",
        "cli_error_first_word_gate_test.go",
        "container_memory_tag_test.go",
        "container_startup_timeout_test.go",
        "copy_method_rebuild_detector_test.go",
        "copy_method_rebuild_test.go",
        "docs_consistency_test.go",
        "dst_seam_gate_test.go",
        "duec_wallclock_gate_scope_test.go",
        "fallback_walk_test.go",
        "field_debt_authority_test.go",
        "field_debt_rfc_census_arms_test.go",
        "field_debt_rfc_census_test.go",
        "field_debt_rfc_order_edges_arms_test.go",
        "field_debt_rfc_order_edges_test.go",
        "field_decision_site_key_test.go",
        "field_name_decision_detector_test.go",
        "field_name_decision_test.go",
        "gemerge_wallclock_gate_scope_test.go",
        "index_scan_carrier_gate_test.go",
        "java_target_version_matcher_test.go",
        "leg_identity_construction_test.go",
        "mixed_seed_element_authority_test.go",
        "nested_accessor_chain_gate_test.go",
        "nightly_window_gate_test.go",
        "nightly_window_landing_test.go",
        "ordering_claim_authority_test.go",
        "panic_boundary_test.go",
        "pinned_ordinal_domain_test.go",
        "plan_proto_schema_test.go",
        "pr_check_gate_test.go",
        "precommit_codegen_globs_test.go",
        "precommit_hook_message_test.go",
        "qualifier_recovery_gate_test.go",
        "race_lane_scope_test.go",
        "receiver_write_census_test.go",
        "receiver_write_detector_test.go",
        "result_type_stub_census_test.go",
        "rowdiff_sweep_budget_test.go",
        "rowvalue_map_expectation_test.go",
        "slot_order_derivation_test.go",
        "source_hygiene_test.go",
        "source_relative_baked_visibility_test.go",
        "star_body_named_column_census_test.go",
        "status_page_crossref_test.go",
        "store_timer_event_taxonomy_test.go",
        "test_filter_resolution_test.go",
        "unknown_type_mint_census_test.go",
        "unreferenced_func_detector_pins_test.go",
        "unreferenced_func_detector_test.go",
        "unreferenced_func_gate_test.go",
        "unreferenced_func_guard_pins_test.go",
        "unreferenced_func_ledger_pins_test.go",
        "vuln_gate_test.go",
        "yamsql_plan_claim_gate_test.go",
    ],
    # keep: living docs + archived snapshots staged into runfiles so the guard can read
    # them under Bazel (the same files `go test` reads from the repo tree). RFC-131.
    data = [
        "//:CHANGELOG.md",
        "//:DIVERGENCES.md",
        "//:MODULE.bazel",
        "//:PRODUCTION_READINESS.md",
        "//:README.md",
        "//:RELEASE.md",
        "//:TODO.md",
        # keep: the GitHub Actions workflows, read by the nightly-window gate and
        # by TestRowdiffSweepBudgetBoundsTheTimeout (which checks that every
        # rowdiff sweep's in-test ROWDIFF_BUDGET fires before its Bazel
        # --test_timeout). Without these staged the tests read an absent directory
        # and fail loudly rather than scanning an empty set.
        "//:github_workflows",
        "//:go.mod",
        # keep: the yamsql corpus and the corpus-wide plan rendering, staged so
        # TestYamsqlPlanClaimsAreAsserted can read the scenarios it gates and
        # derive its operator vocabulary from the rendered plans. Without these
        # the test finds no files and its population guard fails loudly rather
        # than passing on an empty set.
        "//pkg/relational/conformance/explaindiff:plan_shape_golden",
        "//pkg/relational/conformance/yamsql:testdata",
        # keep: the vendored Java .yamsql corpus, the second half of the
        # star-body-by-name census (TestStarBodyColumnsAreAddressedByName). Drop
        # this and the walk finds no files, which its per-corpus floor catches.
        "//third_party/apple/fdb-record-layer:yamsql_corpus",
        # keep: the pre-commit hook body is extracted from the install-hooks recipe,
        # which is its tracked source of truth (TestPreCommitHookNamesTheConditionItDetected).
        "//:justfile",
        # keep: the parser codegen script, followed by
        # TestCodegenOwnedGlobsCoverTheGenerateRecipes from the `bazelisk run` step in
        # `just generate-parser` to the source-tree path it writes. Without it staged
        # that write site is underivable and the gate fails loudly rather than
        # covering one fewer path in silence.
        "//pkg/relational/core/parser/grammar:generate_parser.sh",
        # keep: the production-status authority and the redirect that points at it
        # (B6, TestProductionStatusAuthority).
        "//:road-to-prod.md",
        "//rfcs:prod-readiness-go-client.md",
        "//docs/archive/reports-2026-03-09:snapshots",
        "//reports",
        # keep: RFC-134 panic-boundary doc-sync + fuzz-net guards staged into runfiles
        # (the fuzz _test.go files AND their BUILD.bazel — the guard checks go_test wiring).
        "//docs:mt-saas.md",
        "//docs:panic-audit.md",
        # keep: the API_PARITY honest-options gate parses options.go and
        # cross-checks its classification against API_PARITY.md.
        "//pkg/fdbgo/fdb:API_PARITY.md",
        "//pkg/fdbgo/fdb:options.go",
        "//pkg/fdbgo/fdb/tuple:BUILD.bazel",
        "//pkg/fdbgo/fdb/tuple:tuple_malformed_test.go",
        "//pkg/fdbgo/wire:BUILD.bazel",
        "//pkg/fdbgo/wire:reader_fuzz_test.go",
        "//pkg/relational/core/parser:BUILD.bazel",
        "//pkg/relational/core/parser:fuzz_test.go",
        "//pkg/relational/core/query:BUILD.bazel",
        "//pkg/relational/core/query:cascades_translator_test.go",
    ],
    embed = [":docscheck"],
    # keep: "external" defeats Bazel's test-result cache. The RFC-175 F2 hygiene
    # gate reads the WHOLE source tree (undeclared inputs, resolved via the
    # MODULE.bazel runfiles symlink), so a cached pass would go stale the moment
    # any Go file changes; the suite here is filesystem-only and fast.
    tags = ["external"],
    deps = [
        "//gen",
        "//pkg/linters/norecover",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_x_text//cases",
        "@org_golang_x_text//language",
    ],
)
