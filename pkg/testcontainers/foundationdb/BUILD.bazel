load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "foundationdb",
    srcs = [
        "cluster.go",
        "foundationdb.go",
        "options.go",
    ],
    importpath = "fdb.dev/pkg/testcontainers/foundationdb",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_docker_docker//client",
        "@com_github_docker_go_connections//nat",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//exec",
        "@com_github_testcontainers_testcontainers_go//network",
        "@com_github_testcontainers_testcontainers_go//wait",
    ],
)

# timeout: this suite starts ~14 FDB containers, including a three-replica
# cluster, and it was the ONE container-spinning target in the repo still on
# Bazel's default (medium, 300s) — every sibling that spins containers declares
# a longer one (//pkg/recordlayer is "long"). Measured 2026-08-20 on this tree:
# 18s alone (3/3 runs), and killed at 300s under `bazelisk test //...` with
# .bazelrc's --local_test_jobs=4, hung inside a Docker exec stream read while
# the machine ran four other container-heavy targets.
#
# Under-declaring is a defect in the safety net, not a tuning detail: a target
# killed by its own budget under legitimate load reads as a flake, and "unrelated
# flake" is the story that hides real bugs. "long" (900s) is ~50x the unloaded
# time and 3x the observed stall — proportionate, and far from the multi-hour
# budgets where one wedge costs a runner fleet a day.
go_test(
    name = "foundationdb_test",
    timeout = "long",
    srcs = [
        "cluster_test.go",
        "database_test.go",
        "examples_test.go",
        "foundationdb_test.go",
        "integration_test.go",
        "multinode_client_test.go",
        "multiprocess_test.go",
        "retry_test.go",
    ],
    embed = [":foundationdb"],
    tags = ["resources:memory:1100"],
    deps = [
        "//gen",
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/fdbgo/fdb/tuple",
        "//pkg/recordlayer",
        "@com_github_onsi_gomega//:gomega",
        "@com_github_testcontainers_testcontainers_go//exec",
        "@org_golang_google_protobuf//proto",
    ],
)
