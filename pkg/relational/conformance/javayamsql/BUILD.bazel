load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "javayamsql",
    srcs = [
        "ast.go",
        "census.go",
        "corpus.go",
        "errorcodes.go",
        "manifest.go",
        "parse.go",
        "ranges.go",
        "segment.go",
        "tags.go",
        "value.go",
        "version.go",
    ],
    importpath = "fdb.dev/pkg/relational/conformance/javayamsql",
    visibility = ["//visibility:public"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "javayamsql_test",
    srcs = [
        "corpus_test.go",
        "parse_test.go",
    ],
    # keep: TestCorpusParses walks the vendored .yamsql tree, so it has to be in
    # runfiles. Without this the gate does not fail under `bazel test` — it
    # cannot find the corpus at all, which is a far worse outcome than a diff.
    data = ["//third_party/apple/fdb-record-layer:yamsql_corpus"],
    deps = [":javayamsql"],
)
