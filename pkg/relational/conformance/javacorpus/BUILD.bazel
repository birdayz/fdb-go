load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "javacorpus",
    srcs = [
        "connoptions.go",
        "fixture.go",
        "gaps.go",
        "javarandom.go",
        "ledger.go",
        "match.go",
        "prepared.go",
        "resultmetadata.go",
        "runner.go",
        "runparsed.go",
        "schemacommand.go",
        "testblock.go",
    ],
    importpath = "fdb.dev/pkg/relational/conformance/javacorpus",
    visibility = ["//visibility:public"],
    deps = [
        "//gen",
        "//pkg/fdbgo/fdb",
        "//pkg/recordlayer",
        "//pkg/recordlayer/query/plan/cascades/values",
        "//pkg/recordlayer/vectorcodec",
        "//pkg/relational/api",
        "//pkg/relational/api/ddl",
        "//pkg/relational/conformance/javayamsql",
        "//pkg/relational/conformance/yamsql",
        "//pkg/relational/core/ddl",
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/functions",
        "//pkg/relational/core/keyspace",
        "//pkg/relational/core/metadata",
        "//pkg/relational/core/parser",
        "//pkg/relational/core/parser/gen",
        "@com_github_antlr4_go_antlr_v4//:antlr",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@org_golang_google_protobuf//types/descriptorpb",
        "@org_golang_google_protobuf//types/dynamicpb",
    ],
)

go_test(
    name = "javacorpus_test",
    # timeout="long" => 900s. The target spins one FDB container and runs 238
    # corpus files in parallel against it. Measured ~7s warm on a 24-thread box;
    # the CI runner is memory-capped and runs 4 test actions at once, where the
    # same contention factor the sqldriver and yamsql targets already document
    # applies. Sized to the convention those carry rather than trimming files.
    timeout = "long",
    srcs = [
        "arraymetadata_fdb_test.go",
        "configplan_internal_test.go",
        "corpus_run_test.go",
        "domain_registration_test.go",
        "fixture_internal_test.go",
        "javarandom_test.go",
        "match_float_bits_internal_test.go",
        "match_internal_test.go",
        "pinned_ledger_test.go",
        "prepared_fdb_test.go",
        "resultmetadata_internal_test.go",
        "typenames_internal_test.go",
    ],
    # keep: the run walks the vendored .yamsql tree, so it must be in runfiles.
    # Without this the ledger gate does not fail under `bazel test` — it cannot
    # find the corpus at all, which is a far worse outcome than a drifted count.
    # keep: so are the yaml-tests descriptor sets and metadata JSON that
    # `load schema template` reads.
    data = [
        "//third_party/apple/fdb-record-layer:yamltests_main_proto",
        "//third_party/apple/fdb-record-layer:yamltests_metadata_json",
        "//third_party/apple/fdb-record-layer:yamltests_test_proto",
        "//third_party/apple/fdb-record-layer:yamsql_corpus",
    ],
    embed = [":javacorpus"],
    tags = ["resources:memory:400"],
    deps = [
        "//pkg/dst",
        "//pkg/fdbgo/fdb",
        "//pkg/recordlayer",
        "//pkg/recordlayer/keystoretest",
        "//pkg/recordlayer/query/executor",
        "//pkg/relational/api",
        "//pkg/relational/conformance/javayamsql",
        "//pkg/relational/core/keyspace",
        "//pkg/relational/sqldriver",
        "//pkg/simfdb",
        "//pkg/testcontainers/foundationdb",
        "@com_github_google_uuid//:uuid",
    ],
)
