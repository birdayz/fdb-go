load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plandiff",
    srcs = [
        "column_conform.go",
        "corpus.go",
        "corpus_rfc082_divergences.go",
        "corpus_rfc082_knownred.go",
        "divergence.go",
        "go_runner.go",
        "httpclient.go",
        "plandiff.go",
        "runsql.go",
    ],
    importpath = "fdb.dev/pkg/relational/conformance/plandiff",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/query",
        "//pkg/relational/sqldriver",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "plandiff_test",
    # timeout="long" => 900s. The target runs in ~19s solo but starved past the default
    # medium 300s once the suite grew the RFC-199 hunt targets, which are CPU-bound and
    # scheduled alongside it. Nothing here got slower; the runner got busier. Same
    # right-sizing the rowdiff, sqldriver, chaos and conformance targets carry, and the
    # same reason: medium is only safe for a target that runs close to alone.
    #
    # How far that goes when the runner is not just busy but out of memory: measured
    # 31s solo under -race on four cores, this target reported TIMEOUT in 915.2s on
    # PR #577's race lane — a 29x stretch, with no work of its own added. It was
    # sharing a 7.6 GB box with the 5000-scenario corpus target's ~5 GB. The lesson
    # is not that 900s is too small; it is that a wall-clock budget cannot be met by
    # a target that is not being scheduled. The fix lives in ci.yml's lane scope.
    timeout = "long",
    srcs = [
        "catalog_aware_test.go",
        "column_conform_test.go",
        "go_runner_test.go",
        "in_list_dedup_regression_test.go",
        "join_projection_coltype_regression_test.go",
        "ordinal_plan_stability_test.go",
        "plandiff_test.go",
        "runsql_test.go",
    ],
    embed = [":plandiff"],
    deps = ["//pkg/testcontainers/foundationdb"],
)
