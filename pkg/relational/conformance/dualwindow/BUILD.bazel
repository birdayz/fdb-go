load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "dualwindow_test",
    # size="large" ⇒ 900s bazel timeout. This spins an FDB container AND runs
    # the whole §5 corpus through BOTH the ordinal and name models (a dual-model
    # differential — heavier than a single-model FDB suite), so it belongs on
    # the same "large" budget as sqldriver_test / conformance_test rather than
    # the default "medium" (300s). Runs ~31s locally; the 300s budget flaked
    # under contended-runner slowdown (a ~10x stretch pushed it past 300s while
    # the assertions all passed). No sharding — the corpus shares one container.
    size = "large",
    srcs = [
        "dualwindow_test.go",
        "rfc173_producer_census_test.go",
    ],
    deps = [
        "//pkg/recordlayer/query/executor",
        "//pkg/relational/conformance/plandiff",
        "//pkg/relational/core/query",
        "//pkg/testcontainers/foundationdb",
    ],
)
