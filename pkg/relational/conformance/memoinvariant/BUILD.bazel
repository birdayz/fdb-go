load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "memoinvariant",
    srcs = ["doc.go"],
    importpath = "fdb.dev/pkg/relational/conformance/memoinvariant",
    visibility = ["//visibility:public"],
)

go_test(
    name = "memoinvariant_test",
    # keep: the generative sweep plans seedCount (160) rowdiff cases end to end
    # through the full Cascades pipeline, which MEASURED 201s standalone on this
    # box. The default medium budget is 300s, so the target was passing on 67% of
    # it — and a `bazel test //...` run, which the repo caps at 4 concurrent
    # FDB-container targets, pushed it over and reported a TIMEOUT rather than a
    # failure. That is box variance eating a budget that was never sized for the
    # sweep, not a slow test: raise the budget, and let seedCount stay the knob
    # that decides how much is planned.
    timeout = "long",
    srcs = [
        "memoinvariant_test.go",
        "mutation_test.go",
        "seeds_default_test.go",
        "seeds_race_test.go",
    ],
    embed = [":memoinvariant"],
    deps = [
        "//pkg/recordlayer/query/plan/cascades",
        "//pkg/recordlayer/query/plan/cascades/expressions",
        "//pkg/recordlayer/query/plan/cascades/values",
        "//pkg/recordlayer/query/plan/plans",
        "//pkg/relational/conformance/rowdiff",
        "//pkg/relational/core/embedded",
    ],
)
