load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "factory",
    srcs = [
        "batch.go",
        "candidate.go",
        "execute.go",
        "featurevector.go",
        "inapplicable.go",
        "nested.go",
        "pr_summary.go",
        "sweep.go",
    ],
    importpath = "fdb.dev/pkg/relational/conformance/factory",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/recordlayer/query/plan/cascades/predicates",
        "//pkg/relational/api",
        "//pkg/relational/conformance/explaindiff",
        "//pkg/relational/conformance/factorycorpus",
        "//pkg/relational/conformance/rowdiff",
        "//pkg/relational/conformance/yamsql",
        "//pkg/relational/core/embedded",
    ],
)

go_test(
    name = "factory_test",
    # keep: re-plans every committed scenario's four renderings and re-marshals
    # every family file, which scales with corpus size and runs ~10x slower in
    # the race lane (the canonicality walk alone measured 228s under -race at
    # 5000 scenarios). Eternal is headroom for corpus growth, not present need.
    timeout = "eternal",
    srcs = [
        "collision_test.go",
        "corpus_shared_test.go",
        "determinism_test.go",
        "eligibility_census_test.go",
        "excluded_shape_hunt_fdb_test.go",
        "explain_alias_fdb_test.go",
        "export_test.go",
        "in_collapse_arity_test.go",
        "inapplicable_test.go",
        "nest_tag_test.go",
        "nested_axis_classify_test.go",
        "nested_axis_fdb_test.go",
        "nested_corpus_collision_fdb_test.go",
        "nested_outer_multileg_fdb_test.go",
        "oracle_detectors_test.go",
        "pipeline_test.go",
        "plan_diversity_hunt_fdb_test.go",
        "pr_summary_test.go",
        "qov_binding_shape_test.go",
        "rule_inventory_test.go",
        "second_plan_fdb_test.go",
        "sweep_derivation_test.go",
        "tlp_render_test.go",
        "unstable_subset_test.go",
    ],
    # keep: the determinism gate regenerates every COMMITTED file from its seed,
    # so it needs the corpus the sibling package owns.
    data = ["//pkg/relational/conformance/factorycorpus:testdata"],
    embed = [":factory"],
    tags = [
        "exclusive",
        "resources:memory:3300",
    ],
    deps = [
        "//pkg/recordlayer/query/plan/cascades",
        "//pkg/recordlayer/query/plan/cascades/predicates",
        "//pkg/relational/api",
        "//pkg/relational/conformance/explaindiff",
        "//pkg/relational/conformance/factorycorpus",
        "//pkg/relational/conformance/rowdiff",
        "//pkg/relational/conformance/yamsql",
        "//pkg/relational/core/embedded",
        "//pkg/relational/sqldriver",
        "//pkg/testcontainers/foundationdb",
    ],
)
