    - - query: |-
          SELECT r.id AS r_id, m.id AS m_id, l.id AS l_id, m.b AS m_b FROM t_rd AS l, t_rd AS m, t_rd AS r WHERE l.b = m.id AND m.id = r.id AND (((m.a - m.b) <> 0) AND (m.s <> 'alpha')) ORDER BY l.id, m.id, r.id
