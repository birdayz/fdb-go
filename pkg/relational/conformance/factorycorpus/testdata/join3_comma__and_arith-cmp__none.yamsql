  CREATE TABLE T_RD (id BIGINT NOT NULL, a BIGINT, b BIGINT, c BIGINT, s STRING, f BOOLEAN, d DOUBLE, e FLOAT, PRIMARY KEY (id)) CREATE INDEX idx_c ON T_RD (c) CREATE INDEX idx_d ON T_RD (d) CREATE INDEX idx_ab ON T_RD (a, b) CREATE INDEX idx_b ON T_RD (b)
---
setup:
  connect: 12
  steps:
    - query: |-
        INSERT INTO T_RD VALUES (1, 7, 4611686018427387904, 2, ' a', FALSE, 4.0, 6.0), (2, NULL, 7, 3, 'alpha', TRUE, -0.0, 7.0), (3, 1, 3, NULL, 'gamma', TRUE, 0.1, 8.0), (4, 7, 0, -1, 'b ', FALSE, 9.0, -0.0), (5, 5, 8, 0, '', TRUE, 7.0, 3.0), (6, NULL, 4611686018427387904, -1, '', TRUE, 0.0, 7.0), (7, NULL, 0, 4, 'alpha', FALSE, 0.0, 7.0), (8, NULL, 7, NULL, NULL, FALSE, NULL, 0.0), (9, NULL, 3, 7, '', FALSE, -0.0, 0.0), (10, 5, 8, 7, '', FALSE, 7.0, -0.0), (11, 0, -1, 9, 'epsilon', FALSE, 8.0, 6.0), (12, NULL, 5, 9, 'gamma', FALSE, 5.0, NULL), (13, 8, 7, 8, 'delta', NULL, 1.0, 4.0), (14, NULL, 9, 6, 'epsilon', TRUE, NULL, 4.0), (15, 4611686018427387904, 1, 3, ' a', FALSE, 3.0, 9.0), (16, 7, 1, 2, 'b ', FALSE, -9007199254740992.0, 4.0), (17, 0, 1, NULL, 'delta', FALSE, 7.0, 5.0), (18, 4, 3, 3, '', FALSE, -0.0, 3.0), (19, 5, 0, NULL, 'delta', TRUE, -9007199254740992.0, 9.0), (20, 9, 3, 1, 'delta', FALSE, 3.0, 6.0), (21, NULL, 9, 7, NULL, FALSE, 2.0, NULL), (22, NULL, 0, NULL, 'b ', FALSE, 4.0, NULL), (23, 4, 9, 7, 'beta', FALSE, 0.1, 8.0), (24, 0, 9, 1, '', FALSE, 4.0, 7.0)
---
test_block:
  name: "fc_0000000279_q5_p2"
  preset: single_repetition_ordered
  connect: 12
  tests:
    - - query: |-
          SELECT r.id AS r_id, m.id AS m_id, l.id AS l_id, m.b AS m_b FROM t_rd AS l, t_rd AS m, t_rd AS r WHERE l.b = m.id AND m.id = r.id ORDER BY l.id, m.id, r.id
      - result:
          - {R_ID: 7, M_ID: 7, L_ID: 2, M_B: 0}
          - {R_ID: 3, M_ID: 3, L_ID: 3, M_B: 3}
          - {R_ID: 8, M_ID: 8, L_ID: 5, M_B: 7}
          - {R_ID: 7, M_ID: 7, L_ID: 8, M_B: 0}
