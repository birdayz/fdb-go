  CREATE TABLE T_RD (id BIGINT, a BIGINT, b BIGINT, c BIGINT, s STRING, f BOOLEAN, d DOUBLE, e FLOAT, PRIMARY KEY (id)) CREATE INDEX idx_a ON T_RD (a) CREATE INDEX idx_c ON T_RD (c)
---
setup:
  connect: 288
  steps:
    - query: |-
        INSERT INTO T_RD VALUES (1, NULL, 6, 1, 'delta', FALSE, 9007199254740992.0, 9.0), (2, 7, 3, NULL, 'alpha', NULL, 5.0, 9.0), (3, 3, 2, 4, ' a', TRUE, 5.0, NULL), (4, NULL, 4, 7, 'epsilon', TRUE, 3.0, NULL), (5, 8, 1, 9, '', NULL, 8.0, 16777216.0), (6, 0, 1, 4, '', TRUE, NULL, 6.0), (7, 5, 6, 2, NULL, FALSE, 3.0, 9.0), (8, 0, 7, 3, 'alpha', FALSE, 4.0, 0.0), (9, 9, 4, 8, 'beta', TRUE, 0.0, NULL), (10, 4, 9, NULL, 'delta', TRUE, 9007199254740992.0, 8.0), (11, 9, 6, 6, 'epsilon', TRUE, 2.0, 1.0), (12, 8, 5, NULL, '', TRUE, NULL, 2.0), (13, 3, -1, 2, 'alpha', FALSE, 1.0, 4.0), (14, 9, 8, 7, 'beta', FALSE, 1.0, 5.0), (15, 9, 1, 8, '', TRUE, -0.0, 9.0), (16, 8, 1, 1, 'epsilon', FALSE, 9.0, NULL), (17, 8, 0, 0, 'beta', FALSE, 4.0, NULL), (18, 9, 6, NULL, NULL, FALSE, -9007199254740992.0, NULL), (19, 3, 4611686018427387904, 1, NULL, TRUE, 2.0, 6.0), (20, 3, 4611686018427387904, NULL, 'gamma', NULL, 0.0, 2.0), (21, 4, 8, 9, 'gamma', FALSE, NULL, 8.0), (22, 9, 3, 9, 'beta', FALSE, 6.0, 1.0), (23, 5, 0, 2, 'b ', TRUE, 7.0, 3.0), (24, 3, 7, NULL, NULL, FALSE, 6.0, 8.0)
---
test_block:
  name: "fc_0001904169_q0_p2"
  preset: single_repetition_ordered
  connect: 288
  tests:
    - - query: |-
          SELECT r.id AS r_id, l.id AS l_id, l.b AS l_b FROM t_rd AS l JOIN t_rd AS r ON l.a = r.id
      - unorderedResult:
          - {R_ID: 7, L_ID: 2, L_B: 3}
          - {R_ID: 3, L_ID: 3, L_B: 2}
          - {R_ID: 8, L_ID: 5, L_B: 1}
          - {R_ID: 5, L_ID: 7, L_B: 6}
          - {R_ID: 9, L_ID: 9, L_B: 4}
          - {R_ID: 4, L_ID: 10, L_B: 9}
          - {R_ID: 9, L_ID: 11, L_B: 6}
          - {R_ID: 8, L_ID: 12, L_B: 5}
          - {R_ID: 3, L_ID: 13, L_B: -1}
          - {R_ID: 9, L_ID: 14, L_B: 8}
          - {R_ID: 9, L_ID: 15, L_B: 1}
          - {R_ID: 8, L_ID: 16, L_B: 1}
          - {R_ID: 8, L_ID: 17, L_B: 0}
          - {R_ID: 9, L_ID: 18, L_B: 6}
          - {R_ID: 3, L_ID: 19, L_B: 4611686018427387904}
          - {R_ID: 3, L_ID: 20, L_B: 4611686018427387904}
          - {R_ID: 4, L_ID: 21, L_B: 8}
          - {R_ID: 9, L_ID: 22, L_B: 3}
          - {R_ID: 5, L_ID: 23, L_B: 0}
          - {R_ID: 3, L_ID: 24, L_B: 7}
    - - query: |-
          SELECT r.id AS r_id, l.id AS l_id, l.b AS l_b FROM t_rd AS l JOIN t_rd AS r ON l.a = r.id WHERE ((r.s <> 'gamma') AND (l.a > r.d))
      - unorderedResult:
          - {R_ID: 8, L_ID: 5, L_B: 1}
          - {R_ID: 9, L_ID: 9, L_B: 4}
          - {R_ID: 4, L_ID: 10, L_B: 9}
          - {R_ID: 9, L_ID: 11, L_B: 6}
          - {R_ID: 8, L_ID: 12, L_B: 5}
          - {R_ID: 9, L_ID: 14, L_B: 8}
          - {R_ID: 9, L_ID: 15, L_B: 1}
          - {R_ID: 8, L_ID: 16, L_B: 1}
          - {R_ID: 8, L_ID: 17, L_B: 0}
          - {R_ID: 9, L_ID: 18, L_B: 6}
          - {R_ID: 4, L_ID: 21, L_B: 8}
          - {R_ID: 9, L_ID: 22, L_B: 3}
    - - query: |-
          SELECT r.id AS r_id, l.id AS l_id, l.b AS l_b FROM t_rd AS l JOIN t_rd AS r ON l.a = r.id WHERE NOT ((r.s <> 'gamma') AND (l.a > r.d))
      - unorderedResult:
          - {R_ID: 3, L_ID: 3, L_B: 2}
          - {R_ID: 5, L_ID: 7, L_B: 6}
          - {R_ID: 3, L_ID: 13, L_B: -1}
          - {R_ID: 3, L_ID: 19, L_B: 4611686018427387904}
          - {R_ID: 3, L_ID: 20, L_B: 4611686018427387904}
          - {R_ID: 5, L_ID: 23, L_B: 0}
          - {R_ID: 3, L_ID: 24, L_B: 7}
    - - query: |-
          SELECT r.id AS r_id, l.id AS l_id, l.b AS l_b FROM t_rd AS l JOIN t_rd AS r ON l.a = r.id WHERE ((r.s <> 'gamma') AND (l.a > r.d)) IS NULL
      - unorderedResult:
          - {R_ID: 7, L_ID: 2, L_B: 3}
