  CREATE TABLE T_RD (id BIGINT, a BIGINT, b BIGINT, c BIGINT, s STRING, f BOOLEAN, d DOUBLE, e FLOAT, PRIMARY KEY (id)) CREATE INDEX idx_s ON T_RD (s) CREATE INDEX idx_a ON T_RD (a) CREATE INDEX idx_c ON T_RD (c)
---
setup:
  connect: 309
  steps:
    - query: |-
        INSERT INTO T_RD VALUES (1, 1, 8, 1, 'b ', TRUE, 3.0, -0.0), (2, 1, 0, 0, 'alpha', FALSE, 7.0, 5.0), (3, 6, 9, 2, NULL, TRUE, 0.0, 6.0), (4, 8, 9, 9, 'b ', TRUE, NULL, 8.0), (5, NULL, 6, NULL, 'delta', FALSE, NULL, 1.0), (6, 7, 8, 5, NULL, FALSE, 4.0, 8.0), (7, 0, 5, NULL, 'beta', TRUE, 8.0, 1.0), (8, 0, 3, 7, 'delta', TRUE, 1.0, 2.0), (9, 9, 2, NULL, 'epsilon', FALSE, 4.0, -0.0), (10, NULL, 9, 3, 'gamma', FALSE, 9.0, 1.0), (11, 1, 4, 4, ' c ', FALSE, 6.0, NULL), (12, 5, 6, 9, 'b ', TRUE, 5.0, 6.0), (13, 2, 0, 9, 'b ', NULL, 6.0, 9.0), (14, NULL, -1, 7, NULL, FALSE, 6.0, -16777216.0), (15, 2, 6, NULL, 'alpha', FALSE, 7.0, 9.0), (16, 2, 5, 4611686018427387904, ' c ', TRUE, 3.0, 0.10000000149011612), (17, 4611686018427387904, 0, NULL, 'delta', TRUE, 5.0, 6.0), (18, 6, 1, NULL, 'b ', FALSE, 6.0, 9.0), (19, -1, 5, 6, ' a', FALSE, NULL, 4.0), (20, -1, 8, 0, 'gamma', TRUE, NULL, 0.10000000149011612), (21, 1, 7, 8, 'gamma', FALSE, 0.1, NULL), (22, 8, 9, 0, NULL, FALSE, NULL, NULL), (23, NULL, 9, 4, ' c ', TRUE, 0.1, 9.0), (24, 4, 1, 6, ' a', NULL, 9.0, 2.0)
---
test_block:
  name: "fc_0001928193_q1_p2"
  preset: single_repetition_ordered
  connect: 309
  tests:
    - - query: |-
          SELECT r.id AS r_id, l.id AS l_id, l.b AS l_b FROM t_rd AS l RIGHT JOIN t_rd AS r ON l.a = r.id
