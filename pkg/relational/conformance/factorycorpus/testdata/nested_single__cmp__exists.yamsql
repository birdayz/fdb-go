          SELECT id, a, c, s, f, d, n.a AS n_a, n.b AS n_b, n.s AS n_s FROM t_rdn WHERE NOT EXISTS (SELECT 1 FROM t_rdn AS r WHERE r.a = t_rdn.a) ORDER BY c DESC, id
