          SELECT id, a, c, s, f, d, n.a AS n_a, n.b AS n_b, n.s AS n_s FROM t_rdn WHERE (n.a >= 8) AND NOT EXISTS (SELECT 1 FROM t_rdn AS r WHERE r.a = t_rdn.a) ORDER BY c DESC, id
      - result:
          - {ID: 13, A: !null '', C: 0, S: "alpha", F: false, D: 4.0, N_A: 9, N_B: 1, N_S: "b "}
    - - query: |-
          SELECT id, a, c, s, f, d, n.a AS n_a, n.b AS n_b, n.s AS n_s FROM t_rdn WHERE NOT (n.a >= 8) AND NOT EXISTS (SELECT 1 FROM t_rdn AS r WHERE r.a = t_rdn.a) ORDER BY c DESC, id
      - result:
          - {ID: 16, A: !null '', C: 7, S: "b ", F: true, D: 0.0, N_A: 4, N_B: 6, N_S: "delta"}
    - - query: |-
