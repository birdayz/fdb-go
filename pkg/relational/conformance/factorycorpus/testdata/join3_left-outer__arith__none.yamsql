    - - query: |-
          SELECT r.id AS r_id, m.id AS m_id, l.id AS l_id, m.b AS m_b FROM t_rd AS l JOIN t_rd AS m ON l.id = m.id LEFT JOIN t_rd AS r ON m.a = r.id WHERE ((l.a - l.c) = 7) IS NULL ORDER BY l.id DESC, m.id, r.id
      - result:
          - {R_ID: !null '', M_ID: 21, L_ID: 21, M_B: 3}
