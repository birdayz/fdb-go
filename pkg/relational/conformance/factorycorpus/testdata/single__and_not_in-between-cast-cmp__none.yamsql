          SELECT id, a, c, f, e FROM t_rd WHERE ((e NOT IN (0.1, 1.0, 9007199254740992.0)) AND (c BETWEEN 4 AND 6) AND (f = FALSE) AND (CAST(a AS STRING) <= '1')) IS NULL ORDER BY b, id
      - result:
          - {ID: 9, A: !null '', C: 4, F: !null '', E: !f 8.0}
