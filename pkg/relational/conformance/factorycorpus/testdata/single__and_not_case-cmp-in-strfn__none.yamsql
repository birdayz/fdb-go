          SELECT id, a, c, f, e FROM t_rd WHERE ((e IN (9.0, 4.0, 3.0)) AND (s >= '') AND (d > 0.1) AND (NOT ((CASE WHEN b <= 9 THEN 5 ELSE 3 END) > 5)) AND (LOWER(s) < '')) IS NULL ORDER BY a NULLS LAST, id
      - result:
          - {ID: 5, A: 3, C: 1, F: !null '', E: !null ''}
          - {ID: 19, A: 8, C: 3, F: false, E: !null ''}
          - {ID: 16, A: 9, C: 6, F: false, E: !null ''}
