load("@rules_go//go:def.bzl", "go_library", "go_test")

# keep: the committed RFC-201 factory corpus, exported so the FULL corpus
# target (//pkg/relational/conformance/factorycorpus/full) and the producer's
# determinism gate (//pkg/relational/conformance/factory) can stage it into
# runfiles. It is deliberately NOT under the hand-authored yamsql testdata:
# that directory feeds FEATURE_MATRIX.md, SQL_COVERAGE.md and
# SQL_ANSI_CONFORMANCE.md, and machine volume there would bury the
# hand-authored evidence those ledgers exist to report.
filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)

# keep: the census ratchet's committed baseline. Exported for the same reason.
filegroup(
    name = "census_baseline",
    srcs = ["census_baseline.json"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "factorycorpus",
    srcs = [
        "census.go",
        "doc.go",
        "family.go",
        "header.go",
        "load.go",
        "retirement.go",
        "run.go",
        "summary.go",
        "writer.go",
    ],
    importpath = "fdb.dev/pkg/relational/conformance/factorycorpus",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/relational/api",
        "//pkg/relational/conformance/javacorpus",
        "//pkg/relational/conformance/javayamsql",
        "//pkg/relational/conformance/yamsql",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# The container-free gates: loader, writer round-trip, family mapping, census
# ratchet, and the emitted-format gate (every committed family file must parse
# as clean yamsql). The corpus's EXECUTION lives in the sibling `full` target,
# which runs every committed scenario as ordinary suite content in every
# `just test`; the per-PR stratified-sample tier this package once carried is
# gone because a full run in the same suite makes a sample of the same corpus
# redundant.
go_test(
    name = "factorycorpus_test",
    # long, not moderate: the gates parse the whole committed corpus several
    # times, which scales with corpus size and runs ~10x slower under the race
    # lane — the 5000-scenario corpus blew moderate's 300s under -race (~25s
    # without) while being pure computation, not a hang.
    timeout = "long",
    srcs = [
        "blessing_ratchet_test.go",
        "census_test.go",
        "corpus_shared_test.go",
        "family_test.go",
        "format_gate_test.go",
        "header_duplicate_test.go",
        "incomplete_test.go",
        "retirement_test.go",
        "summary_test.go",
        "writer_test.go",
    ],
    # keep: TestSubtestFramingFitsLogCap reads the console output budget from
    # .bazelrc and fails when the corpus's -test.v framing grows into it. Past
    # that budget Bazel discards a failing target's output wholesale, so a
    # corpus red would name no scenario.
    # keep
    data = glob(["testdata/**"]) + [
        "census_baseline.json",
        "//:.bazelrc",
    ],
    deps = [
        ":factorycorpus",
        "//pkg/relational/api",
        "//pkg/relational/conformance/javacorpus",
        "//pkg/relational/conformance/javayamsql",
        "//pkg/relational/conformance/yamsql",
    ],
)
