load("@rules_go//go:def.bzl", "go_test")

# The full committed RFC-201 corpus runs in `just test-full` and non-race CI,
# as eight shards (see shard_count below).
#
# What it costs, measured, because an earlier version of this comment claimed
# "well under a minute at 2000 scenarios" and the corpus is now 5000:
#
#   514s   non-race, alone on the CI runner (run 30747534073)
#   1328s  -race, four cores, all 5000 scenarios passing
#   1830s  -race on the CI runner while co-scheduled with three other targets
#   3612s  the same, on a run where it hit the wall and TIMED OUT (PR #590)
#
# That last line is why the corpus targets are no longer in the PR race lane
# (ci.yml's REL_SCOPE subtracts them). The
# eternal budget is not the problem and raising it further would not help: the
# spread between 1328s and 3612s is contention on a 7.6 GB box, not work.
go_test(
    name = "full_test",
    # keep: eternal => 3600s via .bazelrc's --test_timeout override. At 5000
    # scenarios the measured -race cost is ~1328s (37%); the headroom is for
    # corpus growth, and cmd/test-budget now reports the utilisation every run
    # so the growth is visible before it is a timeout.
    timeout = "eternal",
    srcs = [
        "domain_registration_test.go",
        "full_corpus_fdb_test.go",
    ],
    data = ["//pkg/relational/conformance/factorycorpus:testdata"],
    # keep: Bazel (rules_go) shards by TOP-LEVEL TEST FUNCTION, and the corpus
    # runs as one function per shard (TestFDB_FactoryCorpusFull0..7, each over a
    # disjoint, size-balanced set of corpus files). Must equal fullShards in
    # full_corpus_fdb_test.go. Each shard is its own process and FDB container.
    shard_count = 8,
    tags = [
        # Per shard: Go 0.8-1.6 GB measured plus its FDB container (~0.6 GB).
        "resources:memory:2000",
        "test-full",
    ],
    deps = [
        "//pkg/relational/conformance/factorycorpus",
        "//pkg/relational/core/keyspace",
        "//pkg/relational/sqldriver",
        "//pkg/testcontainers/foundationdb",
    ],
)
