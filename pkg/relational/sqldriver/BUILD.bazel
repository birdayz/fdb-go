load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sqldriver",
    srcs = [
        "driver.go",
        "dsn.go",
    ],
    importpath = "fdb.dev/pkg/relational/sqldriver",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/internal/fdbclient",
        "//pkg/recordlayer",
        "//pkg/relational/api",
        "//pkg/relational/core/catalog",
        "//pkg/relational/core/ddl",
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/keyspace",
    ],
)

go_test(
    name = "sqldriver_test",
    size = "large",
    # The driver's own tests (DSN, connection, transactions, rows, errors,
    # options) and the internal-package simfdb suites. The end-to-end SQL suite
    # lives in //pkg/relational/sqltest/...; this target is what the CI race lane
    # runs for the SQL layer. Budget history: git log of this file.
    timeout = "eternal",
    srcs = [
        "column_metadata_probe_test.go",
        "connector_dsn_freeze_test.go",
        "driver_test.go",
        "dsn_ddl_scope_option_test.go",
        "dsn_options_test.go",
        "dsn_tags_test.go",
        "embedded_fdb_errors_test.go",
        "execution_stats_fdb_test.go",
        "execution_stats_retry_test.go",
        "main_test.go",
        "memory_budget_fdb_test.go",
        "mt_saas_snippets_compile_test.go",
        "multi_statement_probe_test.go",
        "param_binding_fdb_test.go",
        "param_rendering_probe_test.go",
        "param_string_edge_probe_test.go",
        "prepared_stmt_probe_test.go",
        "resource_limits_fdb_test.go",
        "serializer_options_fdb_test.go",
        "sim_not_exists_time_limit_test.go",
        "sim_page_adaptive_budget_test.go",
        "sim_sql_autocommit_1021_exhaustion_test.go",
        "sim_sql_explicit_tx_fault_test.go",
        "sim_sql_fault_test.go",
        "sim_sql_page_commit_retry_test.go",
        "sim_sql_test.go",
        "sim_sql_tx_budget_test.go",
        "sim_sql_workload_test.go",
        "sim_tx_budget_midpage_test.go",
        "sql_integration_test.go",
        "statement_options_fdb_test.go",
        "stored_query_warmup_race_fdb_test.go",
        "strict_leg_livelock_backstop_test.go",
        "time_budget_ceiling_fdb_test.go",
        "transaction_probe_test.go",
        "transaction_tags_fdb_test.go",
        "tx_budget_retry_fdb_test.go",
        "tx_commit_rollback_probe_test.go",
        "tx_isolation_rfc198_fdb_test.go",
        "tx_ryw_index_range_fdb_test.go",
        "tx_select_isolation_probe_test.go",
        "txctl_statements_probe_test.go",
        "window_options_fdb_test.go",
    ],
    embed = [":sqldriver"],
    tags = [
        "resources:memory:700",
        "test-full",
    ],
    deps = [
        "//gen",
        "//pkg/dst",
        "//pkg/fdbgo/client",
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/fdbgo/fdb/tuple",
        "//pkg/fdbgo/fdbmetrics",
        "//pkg/recordlayer",
        "//pkg/recordlayer/keystoretest",
        "//pkg/relational/api",
        "//pkg/relational/core/ddl",
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/fleet",
        "//pkg/relational/core/keyspace",
        "//pkg/relational/core/metadata",
        "//pkg/relational/sqltest/testkit",
        "//pkg/simfdb",
        "@com_github_google_uuid//:uuid",
    ],
)

# DSN unit tests: no FDB, so they run in the fast lane (`just test`), unlike
# sqldriver_test, which is tagged test-full as a whole.
go_test(
    name = "dsn_test",
    srcs = ["dsn_options_test.go"],
    embed = [":sqldriver"],
    deps = ["//pkg/relational/api"],
)

# The corpus the transaction-budget census reads as DATA rather than as code.
# Declared here because a Bazel test sees only its declared inputs: without this
# filegroup the census runs over an empty runfiles tree and reports zero exposed
# transactions, which is indistinguishable from a clean suite.
filegroup(
    name = "tx_budget_census_corpus",
    srcs = glob(["*_test.go"]),
    visibility = [
        "//pkg/relational/sqltest/guard:__pkg__",
        "//pkg/relational/txbudgetcensus:__pkg__",
    ],
)
