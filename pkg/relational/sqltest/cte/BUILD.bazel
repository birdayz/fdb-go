load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "cte_test",
    size = "large",
    timeout = "eternal",
    srcs = [
        "cte_alias_propagation_probe_test.go",
        "cte_box_unnest_on_resolution_probe_fdb_test.go",
        "cte_column_list_label_fdb_test.go",
        "cte_star_output_label_test.go",
        "main_test.go",
        "multi_cte_probe_test.go",
        "rcte_crossjoin_probe_test.go",
        "recursive_cte_alias_frontier_test.go",
        "recursive_cte_computed_leg_projection_fdb_test.go",
        "recursive_cte_continuation_fdb_test.go",
        "recursive_cte_hierarchy_probe_test.go",
        "recursive_cte_rekey_gate_test.go",
        "recursive_cte_rename_probe_test.go",
        "recursive_cte_star_metadata_test.go",
        "scalar_subquery_cte_test.go",
        "star_body_cte_join_leg_fdb_test.go",
    ],
    tags = [
        "resources:memory:700",
        "test-full",
    ],
    deps = [
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/subspace",
        "//pkg/fdbgo/fdb/tuple",
        "//pkg/recordlayer",
        "//pkg/recordlayer/query/executor",
        "//pkg/relational/api",
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/metadata",
        "//pkg/relational/sqltest/testkit",
        "@com_github_onsi_gomega//:gomega",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/dynamicpb",
    ],
)

# This package's test sources, for the whole-corpus census and the
# transaction-budget census (//pkg/relational/sqltest:corpus).
filegroup(
    name = "corpus",
    srcs = glob(
        ["*_test.go"],
        exclude = ["main_test.go"],
    ),
    visibility = ["//pkg/relational:__subpackages__"],
)
