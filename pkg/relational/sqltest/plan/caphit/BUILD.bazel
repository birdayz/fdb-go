load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "caphit_test",
    size = "large",
    timeout = "eternal",
    srcs = [
        "main_test.go",
        "planner_cap_hit_fdb_test.go",
    ],
    tags = [
        "resources:cpu:2",
        "resources:memory:700",
        "test-full",
    ],
    deps = [
        "//pkg/relational/api",
        "//pkg/relational/core/embedded",
        "//pkg/relational/sqltest/testkit",
    ],
)

# This package's test sources, for the whole-corpus census and the
# transaction-budget census (//pkg/relational/sqltest:corpus).
filegroup(
    name = "corpus",
    srcs = glob(
        ["*_test.go"],
        exclude = ["main_test.go"],
    ),
    visibility = ["//pkg/relational:__subpackages__"],
)
