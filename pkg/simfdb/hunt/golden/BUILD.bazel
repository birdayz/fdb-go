load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//pkg/simfdb:__subpackages__"])

go_library(
    name = "golden",
    srcs = ["golden.go"],
    importpath = "fdb.dev/pkg/simfdb/hunt/golden",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/dstwire",
        "//pkg/dst",
        "//pkg/recordlayer",
        "//pkg/relational/sqldriver",
        "//pkg/simfdb",
    ],
)

go_test(
    name = "golden_test",
    srcs = [
        "domain_registration_test.go",
        "golden_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":golden"],
    deps = ["//pkg/relational/core/keyspace"],
)
