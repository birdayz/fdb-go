# scenario: multikey (seed 3)
#   CREATE TABLE t (region BIGINT NOT NULL, id BIGINT NOT NULL, v BIGINT, PRIMARY KEY (region, id))

=== SELECT region, id, v FROM t ORDER BY region, id
PLAN: Project([REGION, ID, V], Scan(T))
ROWS(6) cols=[REGION, ID, V]:
  [1, 1, 100]
  [1, 2, 200]
  [1, 3, 300]
  [2, 1, 400]
  [2, 2, 500]
  [3, 1, 600]

=== SELECT id, v FROM t WHERE region = 1 ORDER BY id
PLAN: Project([ID, V], InMemorySort([ID ASC], Scan(T, [=])))
ROWS(3) cols=[ID, V]:
  [1, 100]
  [2, 200]
  [3, 300]

=== SELECT v FROM t WHERE region = 2 AND id = 2
PLAN: Project([V], Scan(T, [=, =]))
ROWS(1) cols=[V]:
  [500]

=== SELECT region, id FROM t WHERE region = 2 AND id > 1 ORDER BY id
PLAN: Project([REGION, ID], InMemorySort([ID ASC], Scan(T, [=, <>])))
ROWS(1) cols=[REGION, ID]:
  [2, 2]

=== SELECT region, COUNT(*), SUM(v) FROM t GROUP BY region ORDER BY region
PLAN: StreamingAgg(keys=[REGION], Scan(T))
ROWS(3) cols=[REGION, COUNT(*), SUM(V)]:
  [1, 3, 600]
  [2, 2, 900]
  [3, 1, 600]

