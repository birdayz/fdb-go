  [2, 1, 200, "b", false]
  [3, 2, 150, "c", true]
  [4, 2, 150, "d", false]
  [5, 3, NULL, "e", true]
  [6, 3, 300, NULL, false]
  [7, 1, 50, "g", true]
  [8, 2, 250, "h", NULL]

