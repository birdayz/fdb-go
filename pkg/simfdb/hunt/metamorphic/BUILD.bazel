load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//pkg/simfdb:__subpackages__"])

go_library(
    name = "metamorphic",
    srcs = [
        "corpus.go",
        "metamorphic.go",
    ],
    importpath = "fdb.dev/pkg/simfdb/hunt/metamorphic",
    visibility = ["//cmd/dst-generate:__pkg__"],
    deps = [
        "//pkg/dst",
        "//pkg/recordlayer",
        "//pkg/relational/sqldriver",
        "//pkg/simfdb",
    ],
)

go_test(
    name = "metamorphic_test",
    srcs = [
        "domain_registration_test.go",
        "metamorphic_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":metamorphic"],
    deps = ["//pkg/relational/core/keyspace"],
)
