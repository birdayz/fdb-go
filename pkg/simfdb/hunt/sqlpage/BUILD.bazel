load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sqlpage",
    srcs = ["sqlpage.go"],
    importpath = "fdb.dev/pkg/simfdb/hunt/sqlpage",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/dst",
        "//pkg/recordlayer",
        "//pkg/relational/api",
        "//pkg/relational/core/embedded",
        "//pkg/relational/sqldriver",
        "//pkg/simfdb",
        "//pkg/simfdb/hunt",
    ],
)

go_test(
    name = "sqlpage_test",
    # size="large" => 900s. TestClean drives 15 seeds across 2 row-count profiles, each
    # seed running the whole query matrix twice (paged vs unpaged) through the full SQL
    # stack over SimFDB — CPU-bound, no containers. It finishes in ~38s solo but starved
    # past the default medium 300s when the full suite scheduled it alongside the
    # container-heavy targets. Right-size to the repo's heavy-test convention (same
    # rationale as the chaos, sqldriver and conformance targets) rather than cut seeds:
    # the seed count IS the coverage this oracle exists for.
    size = "large",
    srcs = [
        "distinct_continuation_test.go",
        "injoin_continuation_test.go",
        "sqlpage_test.go",
        "unionall_continuation_test.go",
    ],
    embed = [":sqlpage"],
)
