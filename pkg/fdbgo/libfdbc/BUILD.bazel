load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# Hand-maintained: the default stub and native backend share an import path.
# gazelle:ignore

go_library(
    name = "libfdbc",
    srcs = ["backend_stub.go"],
    importpath = "fdb.dev/pkg/fdbgo/libfdbc",
    visibility = ["//visibility:public"],
    deps = ["//pkg/fdbgo/fdb"],
)

cc_import(
    name = "fdb_c_shared",
    shared_library = "@libfdb_c_linux_x86_64//file",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# Also consumed by the upstream Apple binding's post-Gazelle cdeps patch.
cc_library(
    name = "fdb_c",
    visibility = ["//visibility:public"],
    deps = [
        ":fdb_c_shared",
        "@fdb_c_headers//:headers",
    ],
)

go_library(
    name = "libfdbc_native",
    srcs = [
        "backend.go",
        "mappedrange_cref.go",
        "options.go",
        "range_cref.go",
        "transaction_timeout.go",
    ],
    cgo = True,
    cdeps = [":fdb_c"],
    importpath = "fdb.dev/pkg/fdbgo/libfdbc",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//pkg/fdbgo/fdb",
        "@com_github_apple_foundationdb_bindings_go//src/fdb",
    ],
)

go_test(
    name = "network_lifecycle_test",
    srcs = ["network_lifecycle_test.go"],
    embed = [":libfdbc_native"],
    gotags = ["libfdbc"],
    pure = "off",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//pkg/fdbgo/fdb",
        "//pkg/testcontainers/foundationdb",
        "@com_github_apple_foundationdb_bindings_go//src/fdb",
    ],
)

go_test(
    name = "mapped_skip_regression_test",
    srcs = ["mapped_skip_regression_test.go"],
    gotags = ["libfdbc"],
    pure = "off",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":libfdbc_native",
        "//pkg/fdbgo/client",
        "//pkg/fdbgo/fdb",
        "//pkg/fdbgo/fdb/tuple",
        "//pkg/testcontainers/foundationdb",
    ],
)
