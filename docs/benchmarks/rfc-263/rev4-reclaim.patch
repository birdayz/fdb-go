+func TestRev4GlobalDrainerCallbackRescans(t *testing.T) {
+	q, clock := rev4Queue()
+	a, b, c := &Transaction{}, &Transaction{}, &Transaction{}
+	rev4Arm(a, q, int64(time.Millisecond))
+	rev4Arm(b, q, int64(time.Millisecond))
+	var order []*Transaction
+	q.deliver = func(tx *Transaction, _ uint64) { order = append(order, tx) }
+	parked, resume, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	q.beforeDeliver = func(n *timeoutNode) {
+		if n == a.timeoutNode {
+			close(parked)
+			<-resume
+		}
+	}
+	clock.Store(int64(2 * time.Millisecond))
+	go func() { q.fire(); close(done) }()
+	<-parked
+	rev4Arm(c, q, int64(3*time.Millisecond))
+	clock.Store(int64(4 * time.Millisecond))
+	b.timeoutNode.queue.fire()
+	if len(order) != 0 {
+		t.Fatal("GLOBAL_DRAINER_OVERLAP: another shard delivered while the owner was paused")
+	}
+	close(resume)
+	<-done
+	if len(order) != 3 || order[0] != a || order[1] != b || order[2] != c {
+		t.Fatalf("GLOBAL_DRAINER_RESCAN: got %v, want [%p %p %p]", order, a, b, c)
+	}
+	runtime.KeepAlive(a)
+	runtime.KeepAlive(b)
+	runtime.KeepAlive(c)
+}
