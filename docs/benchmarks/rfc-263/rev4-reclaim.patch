+func TestRev4RearmAndDisarmNeedNoQueueLock(t *testing.T) {
+	q, clock := rev4Queue()
+	tx := &Transaction{}
+	rev4Arm(tx, q, int64(100*time.Second))
+	clock.Store(int64(4 * time.Second))
+	q.mu.Lock()
+	done := make(chan struct{})
+	go func() {
+		rev4Arm(tx, q, int64(100*time.Second))
+		tx.readErrMu.Lock()
+		tx.disarmTimeoutLocked()
+		tx.readErrMu.Unlock()
+		close(done)
+	}()
+	select {
+	case <-done:
+		q.mu.Unlock()
+	case <-time.After(time.Second):
+		q.mu.Unlock()
+		<-done
+		t.Fatal("FAST_REARM_OR_DISARM_TOOK_QUEUE_LOCK")
+	}
+	runtime.KeepAlive(tx)
+}
