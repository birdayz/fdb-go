+	}
+	t.Logf("LAYOUT queue=%d root=%d node=%d ready=%d construction_allocations=%g", unsafe.Sizeof(timeoutQueue{}), unsafe.Sizeof(timeoutQueueRoot{}), unsafe.Sizeof(timeoutNode{}), unsafe.Sizeof(timeoutReady{}), allocs)
