+func TestRev4EagerSequencePublishedWithInsertion(t *testing.T) {
+	q, clock := rev4Queue()
+	a, b, d := &Transaction{}, &Transaction{}, &Transaction{}
+	var order []*Transaction
+	q.deliver = func(tx *Transaction, _ uint64) { order = append(order, tx) }
+	parked, resume, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	q.beforeEagerSchedule = func(n *timeoutNode) {
+		if n.tx.Value() == a {
+			close(parked)
+			<-resume
+		}
+	}
+	go func() {
+		rev4Arm(a, q, int64(time.Second))
+		close(done)
+	}()
+	<-parked
+	rev4Arm(d, q, int64(2*time.Second))
+	rev4Arm(b, q, int64(time.Second))
+	clock.Store(int64(1500 * time.Millisecond))
+	q.fire()
+	close(resume)
+	<-done
+	clock.Store(int64(3 * time.Second))
+	q.fire()
+	if len(order) != 3 || order[0] != b || order[1] != d || order[2] != a {
+		t.Fatalf("EAGER_PUBLICATION_FIFO: got %v, want [%p %p %p]", order, b, d, a)
+	}
+	runtime.KeepAlive(a)
+	runtime.KeepAlive(b)
+	runtime.KeepAlive(d)
