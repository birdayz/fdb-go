+func TestRev4PopRaceWithRearm(t *testing.T) {
+	q, clock := rev4Queue()
+	tx := &Transaction{}
+	rev4Arm(tx, q, int64(time.Second))
+	parked, resume, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	q.beforeDeliver = func(*timeoutNode) { close(parked); <-resume }
+	clock.Store(int64(time.Second + 100*time.Microsecond))
+	go func() { q.fire(); close(done) }()
