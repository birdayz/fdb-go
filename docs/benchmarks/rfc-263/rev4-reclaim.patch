+
+func TestRev4ConcurrentArms(t *testing.T) {
+	q, clock := rev4Queue()
+	q.deliver = func(*Transaction, uint64) {}
+	txs := make([]*Transaction, 32)
+	var wg sync.WaitGroup
+	for i := range txs {
+		txs[i] = &Transaction{}
+		tx := txs[i]
+		wg.Go(func() {
+			for arm := 0; arm < 1000; arm++ {
+				rev4Arm(tx, q, clock.Load()+int64(100*time.Second))
+				if arm%2 == 0 {
+					tx.readErrMu.Lock()
+					tx.disarmTimeoutLocked()
+					tx.readErrMu.Unlock()
+				}
+				if arm%10 == 0 {
+					clock.Add(int64(100 * time.Millisecond))
+					q.fire()
+				}
+			}
+		})
+	}
+	wg.Wait()
+	runtime.KeepAlive(txs)
+}
