new file mode 100644
index 000000000..fb4bcd52d
--- /dev/null
+++ b/pkg/fdbgo/transport/direct_write.go
@@ -0,0 +1,64 @@
+package transport
+
+import "bytes"
+
+// enqueue hands req to writeLoop, counting it first so that no direct write
+// can overtake it. done (nil: none) abandons the enqueue as c.ctx does.
+func (c *Conn) enqueue(req writeReq, done <-chan struct{}) bool {
+	c.queued.Add(1)
+	select {
+	case c.writeCh <- req:
+		return true
+	case <-c.ctx.Done():
+	case <-done:
+	}
+	c.queued.Add(-1)
+	return false
+}
+
+// tryEnqueue is enqueue for fire-and-forget frames that a full queue drops.
+func (c *Conn) tryEnqueue(req writeReq) bool {
+	c.queued.Add(1)
+	select {
+	case c.writeCh <- req:
+		return true
+	default:
+		c.queued.Add(-1)
+		return false
+	}
+}
+
+// tryWriteDirect writes the frame on the caller's goroutine when nothing is
+// queued and writeLoop is idle, saving the handoff to writeLoop and back. The
+// write never blocks: whatever a full socket refuses, writeLoop finishes.
+// Unlike C++'s connectionWriter this first frame is not coalesced with others.
+func (c *Conn) tryWriteDirect(token UID, body []byte) (bool, error) {
+	if c.raw == nil || c.queued.Load() != 0 || !c.writeMu.TryLock() {
+		return false, nil
+	}
+	defer c.writeMu.Unlock()
+	// A frame may have been queued between the Load and the TryLock. writeLoop
+	// keeps the lock until its batch is flushed, so zero here means a quiet socket.
+	if c.queued.Load() != 0 || c.ctx.Err() != nil {
+		return false, nil
+	}
+	bufp, frame := encodeFrame(token, body, c.useTLS)
+	defer putFrame(bufp, frame)
+	n, err := writeNonBlocking(c.raw, frame)
+	if err != nil {
+		// As in writeLoop: maybe delivered, and failed under writeMu so that no
+		// frame follows a torn one.
+		err = codedConnClosed(err)
+		c.failConnection(err)
+		return true, err
+	}
+	if n < len(frame) {
+		c.tail = bytes.Clone(frame[n:])
+		c.queued.Add(1)
+		select {
+		case c.tailKick <- struct{}{}:
+		default:
+		}
+	}
+	return true, nil
+}
