 	// Apply test-only knobs BEFORE any loop goroutine starts (no data race).
 	for _, o := range opts {
@@ -574,10 +581,15 @@ func (c *Conn) SendFrame(destToken UID, body []byte) error {
 			destToken.First, destToken.Second, len(body))
 	}
 	LogSend(destToken, body)
+	if direct, err := c.tryWriteDirect(destToken, body); direct {
+		return err
+	}
 	errCh := errChanPool.Get().(chan error)
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- writeReq{token: destToken, body: body, errCh: errCh}:
 	case <-c.ctx.Done():
+		c.queued.Add(-1)
 		errChanPool.Put(errCh)
 		return errConnClosed
 	}
@@ -596,16 +608,39 @@ func (c *Conn) SendFrame(destToken UID, body []byte) error {
 	}
 }
 
+// tryWriteDirect writes the frame on the caller's goroutine when the writer is
+// idle and nothing is queued ahead of it, saving the handoff to writeLoop and back.
+func (c *Conn) tryWriteDirect(token UID, body []byte) (bool, error) {
+	if !c.directWrites || c.queued.Load() != 0 || !c.writeMu.TryLock() {
+		return false, nil
+	}
+	// Recheck under the lock: writeLoop releases it only once its batch is flushed.
+	if c.queued.Load() != 0 || c.ctx.Err() != nil {
+		c.writeMu.Unlock()
+		return false, nil
+	}
+	err := WriteFrame(c.conn, token, body, c.useTLS)
+	c.writeMu.Unlock()
+	if err != nil {
+		// As in writeLoop: the frame may or may not have reached the peer.
+		err = codedConnClosed(err)
+		c.failConnection(err)
+	}
+	return true, err
+}
+
 // SendFrameDeferred writes a raw frame WITHOUT waiting for flush.
 // The write loop will flush it with the next batch. Used for pipelining:
 // send N frames, then call Flush() (or let the write loop auto-flush).
 func (c *Conn) SendFrameDeferred(destToken UID, body []byte) error {
 	LogSend(destToken, body)
 	c.hasDirty.Store(true) // mark dirty so Flush() knows to synchronize
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- writeReq{token: destToken, body: body}:
 		return nil
 	case <-c.ctx.Done():
+		c.queued.Add(-1)
 		return errConnClosed
 	}
 }
@@ -614,13 +649,15 @@ func (c *Conn) SendFrameDeferred(destToken UID, body []byte) error {
 // For the write-loop architecture, this sends a synchronous flush marker
 // through the write channel and waits for acknowledgment.
 func (c *Conn) Flush() error {
-	if !c.hasDirty.Load() {
+	if !c.hasDirty.Load() || c.queued.Load() == 0 {
 		return nil
 	}
 	errCh := errChanPool.Get().(chan error)
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- writeReq{errCh: errCh}: // empty token+body = flush-only request
 	case <-c.ctx.Done():
+		c.queued.Add(-1)
 		errChanPool.Put(errCh)
 		return errConnClosed
 	}
@@ -667,6 +704,8 @@ func (c *Conn) writeLoop() {
 		if req.owned != nil {
 			owned = append(owned, req.owned)
 		}
+		c.writeMu.Lock()
+		batched := int64(1)
 		// Process first frame.
 		var writeErr error
 		if req.token != (UID{}) || req.body != nil {
@@ -681,6 +720,7 @@ func (c *Conn) writeLoop() {
 		for draining && writeErr == nil {
 			select {
 			case req = <-c.writeCh:
+				batched++
 				if req.owned != nil {
 					owned = append(owned, req.owned)
 				}
@@ -700,6 +740,8 @@ func (c *Conn) writeLoop() {
 			writeErr = c.wbuf.Flush()
 		}
 		c.hasDirty.Store(false)
+		c.queued.Add(-batched)
+		c.writeMu.Unlock()
 
 		// Notify all waiting senders. A write error means the frame may or may
 		// not have reached the peer before the socket died — code it as the
@@ -959,10 +1001,12 @@ func (c *Conn) handlePing(body []byte) {
 	replyBody := buildVoidReply()
 
 	// Send ping reply through the write loop. Fire-and-forget (no errCh).
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- writeReq{token: replyToken, body: replyBody}:
 	default:
 		// Write channel full — drop ping reply. Server will retry.
+		c.queued.Add(-1)
 	}
 }
 
@@ -1174,9 +1218,11 @@ func (c *Conn) sendPingWithReply() <-chan struct{} {
 	replyToken, replyCh, replyHandle := c.PrepareReply()
 	pingEP := WellKnownToken(WLTokenPingPacket)
 	body := BuildPingRequest(replyToken)
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- writeReq{token: pingEP, body: body}:
 	default:
+		c.queued.Add(-1)
 		// writeCh is saturated — we could not send the PING. Return a nil
 		// channel, NOT a closed one. A closed channel makes the monitor's
 		// `case <-replyCh` fire immediately and falsely conclude "connection
diff --git a/pkg/fdbgo/transport/conn_direct_write_test.go b/pkg/fdbgo/transport/conn_direct_write_test.go
new file mode 100644
index 000000000..ee90b717a
--- /dev/null
+++ b/pkg/fdbgo/transport/conn_direct_write_test.go
@@ -0,0 +1,206 @@
+package transport
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+// directConn has no writeLoop: a frame that is queued instead of written by its
+// caller stays in writeCh.
+func directConn(t *testing.T, nc net.Conn) *Conn {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	return &Conn{
+		conn: nc, ctx: ctx, cancel: cancel, writeCh: make(chan writeReq, 8),
+		pending: make(map[UID]chan Response), directWrites: true,
+	}
+}
+
+func readFrameWithin(t *testing.T, r net.Conn) (UID, []byte) {
+	t.Helper()
+	_ = r.SetReadDeadline(time.Now().Add(5 * time.Second))
+	var fr FrameReader
+	token, body, err := fr.Read(r, false)
+	if err != nil {
+		t.Fatalf("peer read: %v", err)
+	}
+	return token, body
+}
+
+// An idle writer lets the caller write its own frame; the round trip through
+// writeLoop and back cost two goroutine handoffs per request.
+func TestSendWritesDirectlyWhenWriterIdle(t *testing.T) {
+	t.Parallel()
+	cli, srv := net.Pipe()
+	defer srv.Close()
+	c := directConn(t, cli)
+	for i, send := range []func() error{
+		func() error { return c.SendFrame(UID{First: 1}, []byte("commit")) },
+		func() error {
+			_, err := c.SendFrameContext(context.Background(), UID{First: 2}, []byte("read"))
+			return err
+		},
+	} {
+		done := make(chan error, 1)
+		go func() { done <- send() }()
+		token, body := readFrameWithin(t, srv)
+		if token.First != uint64(i+1) {
+			t.Fatalf("send %d: peer got token %d", i, token.First)
+		}
+		if err := <-done; err != nil {
+			t.Fatalf("send %d: %v (body %q)", i, err, body)
+		}
+	}
+	if n := len(c.writeCh); n != 0 || c.queued.Load() != 0 {
+		t.Fatalf("WRITE_DIRECT: %d frames queued, queued=%d, want written by the caller", n, c.queued.Load())
+	}
+}
+
+// A caller must not write ahead of a frame already handed to writeLoop.
+func TestDirectWriteNeverOvertakesQueuedFrame(t *testing.T) {
+	t.Parallel()
+	cli, srv := net.Pipe()
+	defer srv.Close()
+	c := directConn(t, cli)
+	if err := c.SendFrameDeferred(UID{First: 1}, []byte("first")); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- c.SendFrame(UID{First: 2}, []byte("second")) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for len(c.writeCh) < 2 {
+		if time.Now().After(deadline) {
+			t.Fatal("WRITE_REORDER: second frame bypassed the queue")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if first, second := <-c.writeCh, <-c.writeCh; first.token.First != 1 || second.token.First != 2 {
+		t.Fatalf("queue order = %d, %d", first.token.First, second.token.First)
+	}
+	c.cancel()
+	if err := <-done; !errors.Is(err, ErrConnClosed) {
+		t.Fatalf("stranded queued sender returned %v", err)
+	}
+}
+
+// With nothing queued every earlier frame is already on the socket, so a flush
+// has nothing to wait for.
+func TestFlushWithNothingQueuedDoesNotWait(t *testing.T) {
+	t.Parallel()
+	cli, srv := net.Pipe()
+	defer srv.Close()
+	c := directConn(t, cli)
+	c.hasDirty.Store(true)
+	done := make(chan error, 2)
+	go func() { done <- c.Flush() }()
+	go func() { done <- c.FlushContext(context.Background()) }()
+	for range 2 {
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("FLUSH_WAITS: flush with nothing queued waited for a writer")
+		}
+	}
+}
+
+type failingConn struct{ net.Conn }
+
+func (failingConn) Write([]byte) (int, error) { return 0, errors.New("forced write failure") }
+
+// A failed direct write fails the connection exactly as a failed writeLoop write.
+func TestDirectWriteFailureFailsConnection(t *testing.T) {
+	t.Parallel()
+	cli, srv := net.Pipe()
+	defer srv.Close()
+	c := directConn(t, failingConn{cli})
+	_, replies, handle := c.PrepareReply()
+	defer handle.Release()
+	if err := c.SendFrame(UID{First: 1}, []byte("x")); !errors.Is(err, ErrConnClosed) {
+		t.Fatalf("SendFrame = %v, want the coded teardown", err)
+	}
+	if !c.IsClosed() {
+		t.Fatal("failed direct write left the connection open")
+	}
+	if r := <-replies; !errors.Is(r.Err, ErrConnClosed) {
+		t.Fatalf("pending reply = %v, want the coded teardown", r.Err)
+	}
+}
+
+// Direct writers and writeLoop share one socket: every frame must arrive whole
+// and each sender's frames in its own order. Run under -race.
+func TestDirectAndQueuedWritersInterleaveSafely(t *testing.T) {
+	t.Parallel()
+	s := newSimServer(t)
+	go func() { _ = s.handshake() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	c, err := dialWith(ctx, "sim", s.dialFunc(), nil, withMonitorCadence(time.Hour, time.Hour))
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	defer c.Close()
+	const senders, frames = 8, 50
+	got := make(chan error, 1)
+	go func() {
+		next := make([]uint64, senders)
+		var fr FrameReader
+		for range senders * frames {
+			token, body, err := fr.Read(s.srv, false)
+			if err != nil {
+				got <- err
+				return
+			}
+			w, seq := token.First, token.Second
+			if seq != next[w] || string(body) != fmt.Sprint(w, "/", seq) {
+				got <- fmt.Errorf("sender %d: frame %d %q, want %d", w, seq, body, next[w])
+				return
+			}
+			next[w]++
+		}
+		got <- nil
+	}()
+	var wg sync.WaitGroup
+	for w := range senders {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for seq := range frames {
+				token, body := UID{First: uint64(w), Second: uint64(seq)}, []byte(fmt.Sprint(w, "/", seq))
+				var err error
+				switch seq % 3 {
+				case 0:
+					err = c.SendFrame(token, body)
+				case 1:
+					_, err = c.SendFrameContext(ctx, token, body)
+				default:
+					err = c.SendFrameDeferred(token, body)
+				}
+				if err != nil {
+					t.Error(err)
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if err := c.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-got:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("peer did not receive every frame")
+	}
+}
