+
 	// Debug tracing (set before first use).
 	debugFrames bool
 	debugWriter io.Writer
@@ -433,6 +439,7 @@ func dialWith(ctx context.Context, addr string, dialFn DialFunc, tlsConfig *tls.
 		//	init( CONNECTION_MONITOR_TIMEOUT,   isSimulated ? 1.50 : 2.0 );
