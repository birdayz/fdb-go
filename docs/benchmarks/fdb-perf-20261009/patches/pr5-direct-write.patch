+	_ = c.SendFrameDeferred(UID{First: 1}, []byte("AAAAAAAA"))
 	awaitWithin(t, 2*time.Second, readStarted, "writeLoop never reached Flush (server saw no bytes)")
 
 	// Sender B queues behind the stuck writeLoop. Wait until it is provably in
@@ -277,7 +277,6 @@ func TestConn_CtxCancelUnblocksStrandedSendFrame(t *testing.T) {
 	c.cancel()
 
 	awaitWithin(t, 3*time.Second, bDone, "SendFrame B stranded — Bug 1: queued sender hangs on <-errCh after ctx cancel")
-	awaitWithin(t, 3*time.Second, aDone, "SendFrame A stranded after ctx cancel")
 }
 
 // TestConn_CtxCancelUnblocksStrandedFlush is the Flush analog: a flush-only
diff --git a/pkg/fdbgo/transport/write_context.go b/pkg/fdbgo/transport/write_context.go
index 626d56a43..241ecc970 100644
--- a/pkg/fdbgo/transport/write_context.go
+++ b/pkg/fdbgo/transport/write_context.go
@@ -53,7 +53,7 @@ func (c *Conn) SendFrameContext(ctx context.Context, token UID, body []byte) (en
 // FlushContext waits for an ordered flush marker without coupling a read's
 // cancellation to the lifetime of the shared connection.
 func (c *Conn) FlushContext(ctx context.Context) error {
-	if !c.hasDirty.Load() {
+	if !c.hasDirty.Load() || c.queued.Load() == 0 {
 		return ctx.Err()
 	}
 	_, err := c.writeContext(ctx, UID{}, nil, true)
@@ -64,12 +64,15 @@ func (c *Conn) writeContext(ctx context.Context, token UID, body []byte, flush b
 	if err := ctx.Err(); err != nil {
 		return false, err
 	}
+	if !flush {
+		LogSend(token, body)
+		if direct, err := c.tryWriteDirect(token, body); direct {
+			return true, err
+		}
+	}
 	completion := newWriteCompletion()
 	defer completion.release() // caller reference, including abandonment
 	request := writeReq{token: token, body: bytes.Clone(body), owned: completion}
-	if !flush {
-		LogSend(token, request.body)
-	}
 	enqueued, err := c.enqueueOwned(ctx, request)
 	if !enqueued {
 		completion.release() // ownership never transferred to the writer
@@ -119,12 +122,15 @@ func (c *Conn) enqueueOwned(ctx context.Context, request writeReq) (bool, error)
 	if c.writeClosed || c.ctx.Err() != nil {
 		return false, errConnClosed
 	}
+	c.queued.Add(1)
 	select {
 	case c.writeCh <- request:
 		return true, nil
 	case <-ctx.Done():
+		c.queued.Add(-1)
 		return false, ctx.Err()
 	case <-c.ctx.Done():
+		c.queued.Add(-1)
 		return false, errConnClosed
 	}
 }
