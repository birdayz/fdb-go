@@ -260,9 +260,9 @@ func TestConn_CtxCancelUnblocksStrandedSendFrame(t *testing.T) {
 	}
 	defer c.Close()
 
-	// Sender A → writeLoop dequeues it and blocks in Flush (server reads 1 byte).
-	aDone := make(chan struct{})
-	go func() { _ = c.SendFrame(UID{First: 1}, []byte("AAAAAAAA")); close(aDone) }()
+	// Frame A (deferred, so it is queued rather than written by its caller) →
