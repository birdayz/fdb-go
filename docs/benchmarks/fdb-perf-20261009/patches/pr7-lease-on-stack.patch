From 7316e83e0564cac6d201dad879b3e550c1f71215 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Johannes=20Br=C3=BCderl?= <johannes.bruederl@gmail.com>
Date: Sun, 11 Oct 2026 02:19:38 +0200
Subject: [PATCH] perf(fdbgo): keep a state call's lease on the caller's stack

enterState heap-allocated an executionLease on every public state call:
fifty per 50-Set commit, 30% of the client's allocations by count. The
admission loop moves to admitState, leaving enterState small enough to
inline, so escape analysis keeps the lease of a call that only defers its
release on the stack.
---
 pkg/fdbgo/client/BUILD.bazel              |  7 +++++++
 pkg/fdbgo/client/lease_alloc_unit_test.go | 14 ++++++++++++++
 pkg/fdbgo/client/transaction_lifetime.go  | 12 ++++++++----
 3 files changed, 29 insertions(+), 4 deletions(-)
 create mode 100644 pkg/fdbgo/client/lease_alloc_unit_test.go

diff --git a/pkg/fdbgo/client/BUILD.bazel b/pkg/fdbgo/client/BUILD.bazel
index 13eddf77c..c9219f3f1 100644
--- a/pkg/fdbgo/client/BUILD.bazel
+++ b/pkg/fdbgo/client/BUILD.bazel
@@ -80,6 +80,13 @@ go_test(
     deps = ["//pkg/fdbgo/wire"],
 )
 
+# gazelle:exclude lease_alloc_unit_test.go
+go_test(
+    name = "lease_alloc_unit_test",
+    srcs = ["lease_alloc_unit_test.go"],
+    embed = [":client"],
+)
+
 # gazelle:exclude grv_batch_unit_test.go
 go_test(
     name = "grv_batch_unit_test",
diff --git a/pkg/fdbgo/client/lease_alloc_unit_test.go b/pkg/fdbgo/client/lease_alloc_unit_test.go
new file mode 100644
index 000000000..4c95dc96b
--- /dev/null
+++ b/pkg/fdbgo/client/lease_alloc_unit_test.go
@@ -0,0 +1,14 @@
+package client
+
+import "testing"
+
+// A state call that only defers its lease's release keeps the lease on its stack;
+// fifty Sets per commit used to heap-allocate fifty leases. Not parallel:
+// AllocsPerRun counts every allocation in the process.
+func TestStateLeaseDoesNotAllocate(t *testing.T) {
+	tx := &Transaction{}
+	defer tx.Cancel()
+	if n := testing.AllocsPerRun(100, func() { _ = tx.TenantId() }); n != 0 {
+		t.Fatalf("LEASE_ALLOC: a state call allocated %v times, want 0", n)
+	}
+}
diff --git a/pkg/fdbgo/client/transaction_lifetime.go b/pkg/fdbgo/client/transaction_lifetime.go
index e3984b737..5d59d724e 100644
--- a/pkg/fdbgo/client/transaction_lifetime.go
+++ b/pkg/fdbgo/client/transaction_lifetime.go
@@ -30,18 +30,22 @@ func (l *executionLease) release() {
 	l.tx.readErrMu.Unlock()
 }
 
-// enterState admits synchronous, context-free state access. The lease, rather
-// than a separate readiness check, protects the entire mutable-state phase.
+// enterState admits synchronous, context-free state access. It inlines, so a
+// caller that only defers release keeps the lease on its stack.
 func (tx *Transaction) enterState() *executionLease {
+	return &executionLease{tx: tx, inc: tx.admitState(), active: true}
+}
+
+// admitState waits out a turnover and counts one user of the current incarnation.
+func (tx *Transaction) admitState() *readIncarnation {
 	for {
 		tx.readErrMu.Lock()
 		ready := tx.readReady
 		if ready == nil {
 			inc := tx.readIncarnationLocked()
 			inc.users++
-			lease := &executionLease{tx: tx, inc: inc, active: true}
 			tx.readErrMu.Unlock()
-			return lease
+			return inc
 		}
 		tx.readErrMu.Unlock()
 		<-ready
