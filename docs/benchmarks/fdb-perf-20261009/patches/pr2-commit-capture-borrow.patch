diff --git a/pkg/fdbgo/client/commit_capture_borrow_unit_test.go b/pkg/fdbgo/client/commit_capture_borrow_unit_test.go
new file mode 100644
index 000000000..fbcd87d0f
--- /dev/null
+++ b/pkg/fdbgo/client/commit_capture_borrow_unit_test.go
@@ -0,0 +1,223 @@
+package client
+
+import (
+	"bytes"
+	"fmt"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"fdb.dev/pkg/fdbgo/transport"
+)
+
+var borrowReplyToken = transport.UID{First: 7, Second: 9}
+
+// borrowTx buffers n Sets of 100-byte values, enough to promote to the bulk slab.
+func borrowTx(n int, fill byte) *Transaction {
+	tx := &Transaction{}
+	tx.tenantId = NoTenantID
+	tx.readVersion = 42
+	for i := range n {
+		tx.Set([]byte(fmt.Sprintf("borrow/key/%04d", i)), bytes.Repeat([]byte{fill}, 100))
+	}
+	tx.AddReadConflictKey([]byte("borrow/read"))
+	return tx
+}
+
+func captureUnderLease(tx *Transaction) *commitInput {
+	lease := tx.enterState()
+	defer lease.release()
+	tx.conflictMu.Lock()
+	muts, writes := tx.mutations, tx.writeConflicts
+	tx.conflictMu.Unlock()
+	return tx.captureCommit(muts, writes)
+}
+
+// deepCopyInput is the pre-borrow capture: every operand in fresh storage.
+func deepCopyInput(in *commitInput) *commitInput {
+	out := *in
+	out.slab = nil
+	out.muts = make([]Mutation, len(in.muts))
+	for i, m := range in.muts {
+		out.muts[i] = Mutation{Type: m.Type, Key: bytes.Clone(m.Key), Value: bytes.Clone(m.Value)}
+	}
+	cloneRanges := func(rs []KeyRange) []KeyRange {
+		c := make([]KeyRange, len(rs))
+		for i, r := range rs {
+			c[i] = KeyRange{Begin: bytes.Clone(r.Begin), End: bytes.Clone(r.End)}
+		}
+		return c
+	}
+	out.readConflicts = cloneRanges(in.readConflicts)
+	out.writeConflicts = cloneRanges(in.writeConflicts)
+	return &out
+}
+
+func commitFrame(in *commitInput) []byte {
+	body, poolBuf := buildCommitInputRequest(in, borrowReplyToken)
+	frame := bytes.Clone(body)
+	marshalBufPool.Put(poolBuf)
+	return frame
+}
+
+func TestCaptureCommitBorrowsSlabInsteadOfCopying(t *testing.T) {
+	t.Parallel()
+	tx := borrowTx(50, 'a')
+	defer tx.Cancel()
+	input := captureUnderLease(tx)
+	if input.slab == nil || input.slab != tx.conflictBufOwner || input.slab.borrows.Load() != 1 {
+		t.Fatal("capture did not borrow the current slab")
+	}
+	for i, m := range input.muts {
+		own := tx.mutations[i]
+		if unsafe.SliceData(m.Key) != unsafe.SliceData(own.Key) || unsafe.SliceData(m.Value) != unsafe.SliceData(own.Value) {
+			t.Fatalf("mutation %d was copied instead of borrowed", i)
+		}
+	}
+	if &input.muts[0] == &tx.mutations[0] {
+		t.Fatal("capture shares the mutation vector a retry refills in place")
+	}
+	owner := input.slab
+	input.release()
+	input.release()
+	if owner.borrows.Load() != 0 || input.slab != nil {
+		t.Fatalf("release left %d borrows", owner.borrows.Load())
+	}
+}
+
+// A retry may carve over its own slab only when no captured commit reads it.
+func TestRetryReusesSlabOnlyWhenSoleHolder(t *testing.T) {
+	t.Parallel()
+	for _, released := range []bool{false, true} {
+		t.Run(fmt.Sprintf("released=%t", released), func(t *testing.T) {
+			t.Parallel()
+			tx := borrowTx(50, 'a')
+			defer tx.Cancel()
+			backing := unsafe.SliceData(tx.conflictBuf)
+			input := captureUnderLease(tx)
+			want := commitFrame(deepCopyInput(input))
+			if released {
+				input.release()
+			}
+			tx.reset(false)
+			for i := range 50 {
+				tx.Set([]byte(fmt.Sprintf("borrow/key/%04d", i)), bytes.Repeat([]byte{'z'}, 100))
+			}
+			reused := unsafe.SliceData(tx.conflictBuf) == backing
+			if reused != released {
+				t.Fatalf("retry reused the slab=%t, want %t", reused, released)
+			}
+			if released {
+				return
+			}
+			if got := commitFrame(input); !bytes.Equal(got, want) {
+				t.Fatal("COMMIT_CAPTURE_MUTATED: captured frame changed after retry carved new writes")
+			}
+			input.release()
+		})
+	}
+}
+
+// Without a pool handle, reset would pool the slab under a fresh one; the
+// capture must install the handle that carries its borrow.
+func TestCaptureCommitTracksOwnerlessSlab(t *testing.T) {
+	t.Parallel()
+	tx := &Transaction{}
+	defer tx.Cancel()
+	tx.conflictBuf = make([]byte, 0, 4096)
+	tx.Set([]byte("ownerless"), []byte("value"))
+	input := captureUnderLease(tx)
+	if input.slab == nil || tx.conflictBufOwner != input.slab {
+		t.Fatal("capture of an ownerless slab did not record its borrow")
+	}
+	tx.postCommitReset()
+	if tx.conflictBuf != nil || tx.conflictBufOwner != nil {
+		t.Fatal("post-commit reset kept the borrowed slab")
+	}
+	if m := input.muts[0]; len(input.muts) != 1 || string(m.Key) != "ownerless" || string(m.Value) != "value" {
+		t.Fatal("COMMIT_CAPTURE_MUTATED: ownerless capture changed after post-commit reset")
+	}
+	input.release()
+}
+
+// A borrowed slab never reaches the pool: later transactions drawing from the
+// same pool must not overwrite what the in-flight commit ships.
+func TestPostCommitResetDoesNotPoolBorrowedSlab(t *testing.T) {
+	t.Parallel()
+	tx := borrowTx(50, 'a')
+	defer tx.Cancel()
+	input := captureUnderLease(tx)
+	want := commitFrame(deepCopyInput(input))
+	tx.postCommitReset()
+	for range 64 {
+		other := borrowTx(50, 'q')
+		other.postCommitReset()
+	}
+	if got := commitFrame(input); !bytes.Equal(got, want) {
+		t.Fatal("COMMIT_CAPTURE_MUTATED: pooled slab was reused while the commit read it")
+	}
+	input.release()
+}
+
+// Reset, retry and Cancel race the commit's encoding the way a caller's
+// goroutine may during the commit RPC. Run under -race: any write to bytes the
+// commit still reads is a reported race, not only a byte mismatch.
+func TestConcurrentResetDuringCommitKeepsCapturedBytes(t *testing.T) {
+	t.Parallel()
+	for _, mode := range []string{"Reset", "retry", "postcommit", "Cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Parallel()
+			tx := borrowTx(50, 'a')
+			input := captureUnderLease(tx)
+			want := commitFrame(deepCopyInput(input))
+			var wg sync.WaitGroup
+			wg.Add(2)
+			go func() {
+				defer wg.Done()
+				for range 20 {
+					if got := commitFrame(input); !bytes.Equal(got, want) {
+						t.Error("COMMIT_CAPTURE_MUTATED: frame changed during concurrent reset")
+						return
+					}
+				}
+			}()
+			go func() {
+				defer wg.Done()
+				switch mode {
+				case "Reset":
+					tx.Reset()
+				case "retry":
+					tx.reset(false)
+				case "postcommit":
+					tx.postCommitReset()
+				case "Cancel":
+					tx.Cancel()
+					return
+				}
+				for i := range 50 {
+					tx.Set([]byte(fmt.Sprintf("borrow/key/%04d", i)), bytes.Repeat([]byte{'z'}, 100))
+				}
+			}()
+			wg.Wait()
+			input.release()
+			tx.Cancel()
+		})
+	}
+}
+
+// The borrow changes only where the bytes live, never what is encoded.
+func TestCaptureCommitFrameMatchesDeepCopy(t *testing.T) {
+	t.Parallel()
+	tx := borrowTx(50, 'a')
+	defer tx.Cancel()
+	tx.Clear([]byte("borrow/clear"))
+	if err := tx.ClearRange([]byte("borrow/range/a"), []byte("borrow/range/z")); err != nil {
+		t.Fatal(err)
+	}
+	tx.Atomic(MutAddValue, []byte("borrow/counter"), []byte{1, 0, 0, 0})
+	input := captureUnderLease(tx)
+	defer input.release()
+	if got, want := commitFrame(input), commitFrame(deepCopyInput(input)); !bytes.Equal(got, want) {
+		t.Fatal("borrowed capture encodes differently from an owned copy")
+	}
+}
