+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for seq := range perSender {
+				if w == 0 && seq == 0 {
+					continue
+				}
+				if err := send(w, seq); err != nil {
+					t.Error(err)
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if err := c.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if err := within(t, got, "peer receiving every frame"); err != nil {
+		t.Fatal(err)
+	}
+	if c.tails.Load() == 0 {
+		t.Fatal("WRITE_TAIL: the idle 1 MiB direct write was not partial")
+	}
+}
+
+// An eager send writes at once on an idle connection and otherwise queues
+// without waiting, behind what is already queued.
+func TestSendFrameEagerContext(t *testing.T) {
+	t.Parallel()
+	cli, srv := tcpPair(t)
+	c := directConn(t, cli)
+	if enqueued, err := c.SendFrameEagerContext(context.Background(), UID{First: 1}, []byte("lone")); !enqueued || err != nil {
+		t.Fatalf("idle eager send = (%v, %v)", enqueued, err)
+	}
+	if token, _ := readFrame(t, srv); token.First != 1 || c.queued.Load() != 0 {
+		t.Fatalf("WRITE_EAGER: peer got token %d, %d queued; want the frame written by its caller", token.First, c.queued.Load())
+	}
+	if err := c.SendFrameDeferred(UID{First: 2}, []byte("queued")); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if enqueued, err := c.SendFrameEagerContext(ctx, UID{First: 3}, []byte("behind")); !enqueued || err != nil {
+		t.Fatalf("eager send behind a queued frame = (%v, %v)", enqueued, err)
+	}
+	if n := len(c.writeCh); n != 2 {
+		t.Fatalf("WRITE_REORDER: %d frames queued, want the eager frame behind the queued one", n)
+	}
+	if first, second := <-c.writeCh, <-c.writeCh; first.token.First != 2 || second.token.First != 3 {
+		t.Fatalf("WRITE_REORDER: queue order = %d, %d", first.token.First, second.token.First)
+	}
+}
diff --git a/pkg/fdbgo/transport/conn_read_buffer_test.go b/pkg/fdbgo/transport/conn_read_buffer_test.go
new file mode 100644
index 000000000..86756b27d
--- /dev/null
+++ b/pkg/fdbgo/transport/conn_read_buffer_test.go
@@ -0,0 +1,132 @@
+package transport
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type readCountingConn struct {
+	net.Conn
+	reads atomic.Int32
+}
+
+func (c *readCountingConn) Read(p []byte) (int, error) {
+	c.reads.Add(1)
+	return c.Conn.Read(p)
+}
+
+func dialCounted(t *testing.T, s *simServer) (*Conn, *readCountingConn) {
+	t.Helper()
+	counted := &readCountingConn{Conn: s.cli}
+	handshook := make(chan error, 1)
+	go func() { handshook <- s.handshake() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	dial := func(context.Context, string, string) (net.Conn, error) { return counted, nil }
+	c, err := dialWith(ctx, "sim", dial, nil, withMonitorCadence(time.Hour, time.Hour))
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	if err := <-handshook; err != nil {
+		t.Fatalf("handshake: %v", err)
+	}
+	t.Cleanup(func() { _ = c.Close() })
+	return c, counted
+}
+
+// sendReplies writes one frame per body to the client in a single socket write.
+func sendReplies(t *testing.T, s *simServer, tokens []UID, bodies [][]byte) {
+	t.Helper()
+	var wire bytes.Buffer
+	for i, body := range bodies {
+		if err := WriteFrame(&wire, tokens[i], body, false); err != nil {
+			t.Fatalf("frame: %v", err)
+		}
+	}
+	go func() { _, _ = s.srv.Write(wire.Bytes()) }()
+}
+
+func awaitReplies(t *testing.T, chans []<-chan Response, bodies [][]byte) {
+	t.Helper()
+	for i, ch := range chans {
+		select {
+		case r := <-ch:
+			if r.Err != nil || !bytes.Equal(r.Body, bodies[i]) {
+				t.Fatalf("reply %d: err=%v, %d bytes, want %d", i, r.Err, len(r.Body), len(bodies[i]))
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatalf("reply %d not delivered", i)
+		}
+	}
+}
+
+func prepareReplies(c *Conn, n int) ([]UID, []<-chan Response) {
+	tokens, chans := make([]UID, n), make([]<-chan Response, n)
+	for i := range n {
+		tokens[i], chans[i], _ = c.PrepareReply()
+	}
+	return tokens, chans
+}
+
+// One socket read must deliver every frame it carries, as C++ connectionReader
+// does; reading length, checksum and payload separately cost three reads each.
+func TestReadLoopDrainsCoalescedRepliesWithOneRead(t *testing.T) {
+	t.Parallel()
+	s := newSimServer(t)
+	c, counted := dialCounted(t, s)
+	tokens, chans := prepareReplies(c, 3)
+	bodies := [][]byte{[]byte("first"), bytes.Repeat([]byte{'b'}, 900), []byte("third")}
+	before := counted.reads.Load()
+	sendReplies(t, s, tokens, bodies)
+	awaitReplies(t, chans, bodies)
+	// The read that carried the frames, plus the next one the loop blocks in.
+	if reads := counted.reads.Load() - before; reads > 2 {
+		t.Fatalf("READLOOP_UNBUFFERED: %d socket reads for 3 coalesced frames, want <= 2", reads)
+	}
+}
+
+// Frames larger than the read buffer, and frames straddling it, arrive intact.
+func TestReadLoopBufferBoundaries(t *testing.T) {
+	t.Parallel()
+	s := newSimServer(t)
+	c, _ := dialCounted(t, s)
+	sizes := []int{1, readBufferSize - 30, 3 * readBufferSize, 0, readBufferSize + 7, 64}
+	tokens, chans := prepareReplies(c, len(sizes))
+	bodies := make([][]byte, len(sizes))
+	for i, n := range sizes {
+		bodies[i] = bytes.Repeat([]byte{byte('a' + i)}, n)
+	}
+	sendReplies(t, s, tokens, bodies)
+	awaitReplies(t, chans, bodies)
+}
+
+// Liveness counts bytes as they arrive, not frames as they complete: a large
+// reply still in transit is progress to the connection monitor, as in C++.
+func TestBytesReceivedCountsPartialFrames(t *testing.T) {
+	t.Parallel()
+	s := newSimServer(t)
+	c, _ := dialCounted(t, s)
+	token, replies, _ := c.PrepareReply()
+	var wire bytes.Buffer
+	if err := WriteFrame(&wire, token, bytes.Repeat([]byte{'p'}, 4096), false); err != nil {
+		t.Fatal(err)
+	}
+	half := wire.Bytes()[:wire.Len()/2]
+	go func() { _, _ = s.srv.Write(half) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for c.BytesReceived() != int64(len(half)) {
+		if time.Now().After(deadline) {
+			t.Fatalf("LIVENESS_PER_FRAME: %d bytes counted with half a frame delivered, want %d", c.BytesReceived(), len(half))
+		}
+		time.Sleep(time.Millisecond)
+	}
+	select {
+	case r := <-replies:
+		t.Fatalf("LIVENESS_PER_FRAME: half a frame produced a reply: %+v", r)
+	default:
+	}
+}
