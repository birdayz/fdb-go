+package client
+
+// EXPERIMENT ONLY (not for commit): FDBGO_EXP_TRACE=<path> records GRV and
+// commit send/reply instants and dumps them on Database.Close.
+
+import (
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"fdb.dev/pkg/fdbgo/transport"
+)
+
+func init() {
+	if expTracePath != "" {
+		transport.ExpTrace = expTrace
+	}
+	if os.Getenv("FDBGO_EXP_BUSYWRITE") == "1" {
+		transport.ExpBusyFn = func() bool { return expOutstanding.Load() > 1 }
+	}
+}
+
+type expEvent struct {
+	t    int64
+	kind byte
+	n    int32
+}
+
+var (
+	expTracePath  = os.Getenv("FDBGO_EXP_TRACE")
+	expTraceMu    sync.Mutex
+	expTraceStart = time.Now()
+	expTraceBuf   []expEvent
+)
+
+func expTrace(kind byte, n int) {
+	if expTracePath == "" {
+		return
+	}
+	t := time.Since(expTraceStart).Nanoseconds()
+	expTraceMu.Lock()
+	if len(expTraceBuf) < 4_000_000 {
+		expTraceBuf = append(expTraceBuf, expEvent{t, kind, int32(n)})
+	}
+	expTraceMu.Unlock()
+}
+
+func expTraceDump() {
+	if expTracePath == "" {
+		return
+	}
+	expTraceMu.Lock()
+	defer expTraceMu.Unlock()
+	f, err := os.Create(expTracePath)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	for _, e := range expTraceBuf {
+		fmt.Fprintf(f, "%d %c %d\n", e.t, e.kind, e.n)
+	}
+}
+
+// expOutstanding counts callers blocked on a reply (EXPERIMENT).
+var expOutstanding atomic.Int64
