+package otel
+
+// Benchmark-only port, for the merge-base, of the custom-store ("fdb") arm of
+// BenchmarkRelLogsVsFDB at archive/otel-relational/g2b-logs: the same corpus,
+// call size, reads, cluster and metrics as BenchmarkLogExport, against the
+// Exporter's FDBBackend logs. It changes no store code. The size scan is the
+// g2b-logs FDBBackend.size with Size.AddKV's prefix count, local because the
+// merge-base Size has no PrefixBytes.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"syscall"
+	"testing"
+	"time"
+
+	"fdb.dev/pkg/fdbgo/fdb"
+	"fdb.dev/pkg/fdbgo/fdb/subspace"
+	"fdb.dev/pkg/recordlayer"
+	foundationdbtc "fdb.dev/pkg/testcontainers/foundationdb"
+	commonpb "go.opentelemetry.io/proto/otlp/common/v1"
+)
+
+// BenchmarkLogExportCustomStore measures the custom store's log ingest client
+// CPU and stored bytes per log and its QueryLogsByTrace latency, two runs on
+// fresh runs. Run it explicitly:
+//
+//	bazelisk test //layers/otel:otel_test --test_arg=-test.run=^$ \
+//	  --test_arg=-test.bench=BenchmarkLogExportCustomStore --test_arg=-test.benchtime=1x \
+//	  --test_output=streamed --nocache_test_results
+func BenchmarkLogExportCustomStore(b *testing.B) {
+	const (
+		logs  = 20000
+		call  = 500
+		reads = 400
+	)
+	cluster := lrBenchCluster(b)
+	ctx := context.Background()
+	corpus := lrBenchCorpus(logs)
+	traces := map[string]bool{}
+	for _, l := range corpus {
+		if l.TraceID != "" {
+			traces[l.TraceID] = true
+		}
+	}
+	var traceIDs []string
+	for tr := range traces {
+		traceIDs = append(traceIDs, tr)
+	}
+	slices.Sort(traceIDs)
+	traceIDs = traceIDs[:min(reads, len(traceIDs))]
+
+	for range b.N {
+		for runIdx := range 2 {
+			cfg := DefaultExporterConfig()
+			cfg.ClusterFile, cfg.Run, cfg.Tenant = cluster, lrBenchRun(b), 11
+			e, err := NewExporter(ctx, cfg)
+			if err != nil {
+				b.Fatal(err)
+			}
+			var before, after syscall.Rusage
+			if err := syscall.Getrusage(syscall.RUSAGE_SELF, &before); err != nil {
+				b.Fatal(err)
+			}
+			start := time.Now()
+			var stats LogExportStats
+			for lo := 0; lo < logs; lo += call {
+				st, err := e.ExportLogs(ctx, slices.Clone(corpus[lo:min(lo+call, logs)]))
+				if err != nil {
+					b.Fatalf("export: %v", err)
+				}
+				stats.Logs += st.Logs
+				stats.Batches += st.Batches
+				stats.StoredBytes += st.StoredBytes
+				stats.LogicalBytes += st.LogicalBytes
+			}
+			wall := time.Since(start)
+			if err := syscall.Getrusage(syscall.RUSAGE_SELF, &after); err != nil {
+				b.Fatal(err)
+			}
+			cpu := lrRusage(after) - lrRusage(before)
+			var lat []time.Duration
+			got := 0
+			for _, tr := range traceIDs {
+				t0 := time.Now()
+				l, err := e.QueryLogsByTrace(ctx, tr, "")
+				if err != nil {
+					b.Fatalf("read: %v", err)
+				}
+				lat = append(lat, time.Since(t0))
+				got += len(l)
+			}
+			slices.Sort(lat)
+			var sz csSize
+			for _, ss := range []subspace.Subspace{e.backend.keys.logs, e.backend.keys.logTrace, e.backend.keys.logEq} {
+				if err := csScan(ctx, e.backend.db, ss.Sub(int64(cfg.Tenant)), &sz); err != nil {
+					b.Fatal(err)
+				}
+			}
+			_ = e.Shutdown(ctx)
+			n := float64(stats.Logs)
+			b.Logf("arm=fdb run=%d logs=%d batches=%d cpu_us_per_log=%.1f wall_s=%.2f kv_bytes_per_log=%.1f prefix_bytes_per_log=%.1f keys_per_log=%.2f stats_stored_per_log=%.1f logical_per_log=%.1f by_trace_reads=%d logs_read=%d p50_ms=%.3f p99_ms=%.3f",
+				runIdx, stats.Logs, stats.Batches, float64(cpu.Microseconds())/n, wall.Seconds(),
+				float64(sz.keyBytes+sz.valueBytes)/n, float64(sz.prefixBytes)/n, float64(sz.keys)/n,
+				float64(stats.StoredBytes)/n, float64(stats.LogicalBytes)/n, len(lat), got,
+				float64(lat[len(lat)/2].Microseconds())/1000, float64(lat[len(lat)*99/100].Microseconds())/1000)
+			b.ReportMetric(float64(cpu.Microseconds())/n, "cpu-us/log")
+			b.ReportMetric(float64(sz.keyBytes+sz.valueBytes)/n, "B/log")
+		}
+	}
+}
+
+// csSize is the head's Size key, byte and prefix counts.
+type csSize struct {
+	keys, keyBytes, valueBytes, prefixBytes int64
+}
+
+// csScan adds ss's key-value pairs, in key order, to total: each key less its
+// common prefix with the previous key plus the value counts as prefix bytes.
+func csScan(ctx context.Context, db *recordlayer.FDBDatabase, ss subspace.Subspace, total *csSize) error {
+	begin, end := ss.FDBRangeKeys()
+	lo, high := begin.FDBKey(), end.FDBKey()
+	var prev []byte
+	for {
+		var rows []fdb.KeyValue
+		if _, err := db.Run(ctx, func(rc *recordlayer.FDBRecordContext) (any, error) {
+			var err error
+			rows, err = rc.ReadTransaction(true).GetRange(fdb.KeyRange{Begin: lo, End: high}, fdb.RangeOptions{Limit: 256}).GetSliceWithError()
+			return nil, err
+		}); err != nil {
+			return err
+		}
+		for _, kv := range rows {
+			total.keys++
+			total.keyBytes += int64(len(kv.Key))
+			total.valueBytes += int64(len(kv.Value))
+			n := 0
+			for n < len(prev) && n < len(kv.Key) && prev[n] == kv.Key[n] {
+				n++
+			}
+			total.prefixBytes += int64(len(kv.Key)-n) + int64(len(kv.Value))
+			prev = kv.Key
+		}
+		if len(rows) < 256 {
+			return nil
+		}
+		lo = append(append(fdb.Key(nil), rows[len(rows)-1].Key...), 0)
+	}
+}
+
+func lrRusage(r syscall.Rusage) time.Duration {
+	return time.Duration(r.Utime.Nano() + r.Stime.Nano())
+}
+
+func lrBenchRun(b *testing.B) string {
+	var nonce [12]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		b.Fatal(err)
+	}
+	return "bench_" + hex.EncodeToString(nonce[:])
+}
+
+// lrBenchCorpus is n GenAI evaluation and inference-detail logs, four per
+// trace with a span each, every fifth uncorrelated.
+func lrBenchCorpus(n int) []LogRecord {
+	out := make([]LogRecord, n)
+	models := []string{"gpt-4o", "claude-3", "gemini-1.5", "llama-3"}
+	for i := range out {
+		l := LogRecord{
+			Timestamp:          int64(1_700_000_000_000_000_000 + i*1000),
+			ObservedTimestamp:  int64(1_700_000_000_000_000_000 + i*1000 + 7),
+			SeverityText:       "INFO",
+			SeverityNumber:     9,
+			EventName:          "gen_ai.evaluation.result",
+			Body:               exStr(fmt.Sprintf("evaluation %d: the answer was relevant and grounded in the retrieved context", i)),
+			ResourceAttributes: []*commonpb.KeyValue{exKV("service.name", exStr(fmt.Sprintf("agent-%d", i%4))), exKV("deployment.environment", exStr("prod"))},
+			ScopeName:          "genai-eval",
+			ScopeVersion:       "1.2.0",
+			Attributes: []*commonpb.KeyValue{
+				exKV("gen_ai.evaluation.name", exStr([]string{"relevance", "groundedness", "toxicity"}[i%3])),
+				exKV("gen_ai.evaluation.score.value", exDouble(float64(i%100)/100)),
+				exKV("gen_ai.evaluation.score.label", exStr([]string{"pass", "fail"}[i%2])),
+				exKV("gen_ai.request.model", exStr(models[i%len(models)])),
+				exKV("gen_ai.response.id", exStr(fmt.Sprintf("resp-%08d", i))),
+				exKV("session.id", exStr(fmt.Sprintf("session-%05d", i/40))),
+				exKV("user.tier", exInt(int64(i%3))),
+			},
+		}
+		if i%2 == 1 {
+			l.EventName = "gen_ai.client.inference.operation.details"
+		}
+		if i%5 != 4 {
+			l.TraceID, l.SpanID = qaID(i/4, 16), qaID(i, 8)
+		}
+		out[i] = l
+	}
+	return out
+}
+
+// lrBenchCluster is startExporterCluster for a benchmark.
+func lrBenchCluster(b *testing.B) string {
+	b.Helper()
+	setup, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	container, err := foundationdbtc.Run(setup, "", foundationdbtc.WithAPIVersion(730))
+	if err != nil {
+		if foundationdbtc.SkipWithoutDocker(err) {
+			b.Skip("FDB not available (no Docker)")
+		}
+		b.Fatal(err)
+	}
+	b.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+		defer cancel()
+		if err := container.Terminate(ctx); err != nil {
+			b.Error(err)
+		}
+	})
+	wire, err := container.ClusterFile(setup)
+	if err != nil {
+		b.Fatal(err)
+	}
+	cluster := filepath.Join(b.TempDir(), "fdb.cluster")
+	if err := os.WriteFile(cluster, []byte(wire), 0o600); err != nil {
+		b.Fatal(err)
+	}
+	return cluster
+}
