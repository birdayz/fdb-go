index 000000000..351d3031f
--- /dev/null
+++ b/layers/otel/exporter_clientmetrics.go
@@ -0,0 +1,7 @@
+package otel
+
+import "fdb.dev/pkg/fdbgo/client"
+
+// ClientMetrics is the FDB client counters of the exporter's database
+// handle, for diagnostics that diff two snapshots (p3-fts-perf harness).
+func (e *Exporter) ClientMetrics() client.ClientMetricsSnapshot { return e.backend.raw.Metrics() }
