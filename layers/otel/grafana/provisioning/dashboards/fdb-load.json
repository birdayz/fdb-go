          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT name, COUNT(*) AS n, AVG(end_ns - start_ns) / 1000000 AS mean_ms FROM spans WHERE $__timeFilter(start_ns) GROUP BY name ORDER BY n DESC"
