{
  "uid": "fdb-load",
  "title": "FoundationDB load (R1)",
  "tags": ["foundationdb", "load"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Spans by service (T0)",
      "type": "timeseries",
      "datasource": {
        "type": "birdayz-foundationdb-datasource",
        "uid": "fdb-dev"
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "birdayz-foundationdb-datasource",
            "uid": "fdb-dev"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeGroupAlias(start_ns, $__interval), service_name, COUNT(*) AS spans FROM spans WHERE $__timeFilter(start_ns) GROUP BY $__timeGroup(start_ns, $__interval), service_name ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error spans",
      "type": "timeseries",
      "datasource": {
        "type": "birdayz-foundationdb-datasource",
        "uid": "fdb-dev"
      },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "birdayz-foundationdb-datasource",
            "uid": "fdb-dev"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeGroupAlias(start_ns, $__interval), COUNT(*) AS spans FROM spans WHERE $__timeFilter(start_ns) AND status_code = 2 GROUP BY $__timeGroup(start_ns, $__interval) ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "title": "Mean span duration (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "birdayz-foundationdb-datasource",
        "uid": "fdb-dev"
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "birdayz-foundationdb-datasource",
            "uid": "fdb-dev"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeGroupAlias(start_ns, $__interval), AVG(end_ns - start_ns) / 1000000 AS mean_ms FROM spans WHERE $__timeFilter(start_ns) GROUP BY $__timeGroup(start_ns, $__interval) ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "title": "Max span duration (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "birdayz-foundationdb-datasource",
        "uid": "fdb-dev"
      },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "birdayz-foundationdb-datasource",
            "uid": "fdb-dev"
          },
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeGroupAlias(start_ns, $__interval), MAX(end_ns - start_ns) / 1000000 AS max_ms FROM spans WHERE $__timeFilter(start_ns) GROUP BY $__timeGroup(start_ns, $__interval) ORDER BY 1"
        }
      ]
    },
    {
