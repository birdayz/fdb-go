load("@otel_rust_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.Bazel.lock",
    "Cargo.lock",
    "Cargo.toml",
    "crate_extension.bzl",
])

filegroup(
    name = "compatibility_fixtures",
    srcs = [
        "testdata/descriptors.pb",
        "testdata/paired-job-v1.schema.json",
        "testdata/vectors.json",
        "testdata/wire_vectors.json",
    ],
    visibility = ["//layers/otel/cmd/otelrust-fixture:__pkg__"],
)

# Byte-exact copy of the frozen runner schema (SHA256 1581c3dd...b18b); the driver
# tests pin its hash and field sets. For the Rust driver and the forthcoming Go control.
filegroup(
    name = "paired_job_schema",
    srcs = ["testdata/paired-job-v1.schema.json"],
    visibility = ["//layers/otel:__subpackages__"],
)

rust_library(
    name = "fdb_otel_rust",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/driver_tests.rs",
            "src/main.rs",
        ],
    ),
    aliases = aliases(),
    compile_data = [":compatibility_fixtures"],
    crate_name = "fdb_otel_rust",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = ["-Dwarnings"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "otel-rust",
    srcs = [
        "src/driver_tests.rs",
        "src/main.rs",
    ],
    aliases = aliases(),
    compile_data = [":compatibility_fixtures"],
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = ["-Dwarnings"],
    visibility = [
        "//layers/otel/cmd/otelrust-control:__pkg__",
        "//layers/otel/cmd/otelrust-fixture:__pkg__",
    ],
    deps = [":fdb_otel_rust"] + all_crate_deps(normal = True),
)

# Test-only live native proof: a libtest executable (for native.rs's cfg(test) hooks)
# run only as data by the Go native integration test, never as a standalone test.
rust_binary(
    name = "native_proof",
    testonly = True,
    srcs = [
        "proof/native_proof.rs",
        "src/native.rs",
    ],
    aliases = aliases(),
    crate_root = "proof/native_proof.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = [
        "--test",
        "-Dwarnings",
    ],
    visibility = ["//layers/otel/cmd/otelrust-fixture:__pkg__"],
    deps = [":fdb_otel_rust"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    size = "small",
    compile_data = [":compatibility_fixtures"],
    crate = ":fdb_otel_rust",
    rustc_flags = ["-Dwarnings"],
)

rust_test(
    name = "driver_test",
    size = "small",
    compile_data = [":compatibility_fixtures"],
    crate = ":otel-rust",
    rustc_flags = ["-Dwarnings"],
)

[
    rust_test(
        name = name + "_test",
        size = "small",
        srcs = ["tests/" + name + ".rs"],
        aliases = aliases(),
        compile_data = [":compatibility_fixtures"],
        crate_root = "tests/" + name + ".rs",
        edition = "2024",
        proc_macro_deps = all_crate_deps(proc_macro = True),
        rustc_flags = ["-Dwarnings"],
        deps = [":fdb_otel_rust"] + all_crate_deps(normal = True),
    )
    for name in [
        "compatibility",
        "large_records",
        "queue",
        "transactions",
    ]
]
