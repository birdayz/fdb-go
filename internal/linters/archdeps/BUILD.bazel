load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "archdeps",
    srcs = ["analyzer.go"],
    importpath = "fdb.dev/internal/linters/archdeps",
    visibility = ["//:__pkg__"],
    deps = ["@org_golang_x_tools//go/analysis"],
)

go_test(
    name = "archdeps_test",
    srcs = [
        "analyzer_test.go",
        "sync_test.go",
    ],
    # keep: MODULE.bazel's runfiles symlink leads sync_test to the real repo tree
    # so it can verify every allowlist entry and scan all packages; local=True
    # ensures the Bazel sandbox does not hide workspace files outside data, and
    # tags=["external"] keeps a cached pass from hiding edits outside this pkg.
    data = ["//:MODULE.bazel"],
    embed = [":archdeps"],
    local = True,
    tags = ["external"],  # keep
    deps = ["@org_golang_x_tools//go/analysis"],
)
