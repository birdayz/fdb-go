load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "norecover",
    srcs = ["analyzer.go"],
    importpath = "fdb.dev/internal/linters/norecover",
    visibility = ["//:__pkg__"],
    deps = ["@org_golang_x_tools//go/analysis"],
)

go_test(
    name = "norecover_test",
    srcs = [
        "analyzer_test.go",
        "doc_sync_test.go",
    ],
    data = [
        # keep: MODULE.bazel anchors the repo-root walk; docs/panic-audit.md is
        # gated against norecover.Allowlist by TestAllowlistMatchesPanicAuditDoc.
        "//:MODULE.bazel",
        "//:docs/panic-audit.md",
    ],
    embed = [":norecover"],
    deps = ["@org_golang_x_tools//go/analysis"],
)
