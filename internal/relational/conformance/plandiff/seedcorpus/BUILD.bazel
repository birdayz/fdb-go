load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//:__subpackages__"])

go_library(
    name = "seedcorpus",
    testonly = True,
    srcs = [
        "corpus.go",
        "corpus_explain.go",
        "corpus_rfc082_divergences.go",
        "corpus_rfc082_knownred.go",
        "loader.go",
    ],
    embedsrcs = [
        "testdata/corpus_00.json",
        "testdata/corpus_01.json",
        "testdata/corpus_02.json",
        "testdata/corpus_03.json",
        "testdata/corpus_04.json",
        "testdata/corpus_05.json",
        "testdata/corpus_06.json",
        "testdata/corpus_07.json",
        "testdata/corpus_08.json",
        "testdata/corpus_09.json",
        "testdata/corpus_10.json",
        "testdata/corpus_11.json",
        "testdata/corpus_12.json",
        "testdata/corpus_13.json",
        "testdata/corpus_14.json",
        "testdata/corpus_15.json",
        "testdata/corpus_16.json",
    ],
    importpath = "fdb.dev/internal/relational/conformance/plandiff/seedcorpus",
    visibility = [
        "//conformance:__subpackages__",
        "//internal/relational/conformance:__subpackages__",
    ],
    deps = ["//internal/relational/conformance/plandiff"],
)

go_test(
    name = "seedcorpus_test",
    # Drives every SeedRunCorpus entry through FDB; same budget as plandiff_test.
    timeout = "long",
    srcs = [
        "corpus_test.go",
        "loader_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":seedcorpus"],
    tags = [
        "resources:cpu:2",
        "resources:memory:400",
    ],
    deps = [
        "//internal/relational/conformance/plandiff",
        "//pkg/testcontainers/foundationdb",
    ],
)
