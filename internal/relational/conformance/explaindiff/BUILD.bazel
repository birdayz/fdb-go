load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//:__subpackages__"])

go_library(
    name = "explaindiff",
    srcs = [
        "diff.go",
        "explaindiff.go",
    ],
    importpath = "fdb.dev/internal/relational/conformance/explaindiff",
    visibility = [
        "//:__subpackages__",
        "//cmd/explain-differ:__pkg__",
        "//cmd/factory-rebless:__pkg__",
        "//cmd/factory-rebless-plan-shapes:__pkg__",
    ],
    deps = [
        "//internal/relational/conformance/yamsql",
        "//internal/relational/relapi",
        "//pkg/recordlayer/query/plan/cascades",
        "//pkg/recordlayer/query/plan/plans",
        "//pkg/relational/core/embedded",
    ],
)

go_test(
    name = "explaindiff_test",
    srcs = [
        "bound_literal_plans_test.go",
        "domain_registration_test.go",
        "explaindiff_internal_test.go",
        "explaindiff_test.go",
        "identifier_agreement_test.go",
        "identifier_agreement_verdict_test.go",
        "ordering_census_test.go",
        "plan_shape_golden_test.go",
        "projected_exists_coverage_test.go",
        "reachability_test.go",
    ],
    # keep: the tests plan every scenario in the yamsql corpus, which lives in
    # a SIBLING package — so it is staged via that package's exported filegroup
    # (a local glob cannot reach it) and read at ../yamsql/testdata, the same
    # path `go test` sees. Without this the tests fail on a missing corpus
    # under Bazel while passing under `go test`. The committed plan-shape golden
    # (RFC-190 190.12) is read at testdata/plan_shape.golden by TestPlanShapeGolden.
    data = [
        "testdata/plan_shape.golden",
        "//internal/relational/conformance/yamsql:testdata",
    ],
    embed = [":explaindiff"],
    tags = ["resources:cpu:8"],
    deps = [
        "//internal/relational/conformance/yamsql",
        "//internal/relational/keyspace",
        "//internal/relational/relapi",
        "//internal/testinstruments/querycensus",
        "//pkg/recordlayer/query/plan/cascades",
        "//pkg/recordlayer/query/plan/cascades/values",
        "//pkg/relational/core/embedded",
        "//pkg/relational/core/parser",
        "//pkg/relational/core/parser/gen",
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)
