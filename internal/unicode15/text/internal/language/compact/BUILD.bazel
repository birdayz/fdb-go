load("@rules_go//go:def.bzl", "go_library")

filegroup(
    name = "unicodepin_sources",
    srcs = glob(["*.go"]),
    visibility = ["//visibility:public"],
)

go_library(
    name = "compact",
    srcs = [
        "compact.go",
        "language.go",
        "parents.go",
        "tables.go",
        "tags.go",
    ],
    importpath = "fdb.dev/internal/unicode15/text/internal/language/compact",
    visibility = ["//internal/unicode15/text:__subpackages__"],
    deps = [
        "//internal/unicode15",
        "//internal/unicode15/text/internal/language",
    ],
)
